#!/usr/bin/env python3
"""
ai-backup — この AI 環境を丸ごとバックアップする。

守る対象:
  1. OpenClaw の設定・認証情報・会話履歴（openclaw backup create）
  2. Obsidian vault（調べて溜めたノート）
  3. 自作スクリプト（~/bin の research-* など）とブリーフィング設定

    ai-backup              バックアップを取る
    ai-backup --list       取ってあるバックアップを一覧
    ai-backup --prune      古いものを消す（既定で30日より前）

保存先は ~/バックアップ。古いものは自動で間引く。
"""

import os
import shutil
import subprocess
import sys
import tarfile
from datetime import datetime, timedelta

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from guardlib import maintenance  # noqa: E402


HOME = os.path.expanduser("~")
DEST = os.path.join(HOME, "バックアップ")
KEEP_DAYS = 30

# まとめて固める対象（存在しないものは黙って飛ばす）
TARGETS = [
    ("obsidian", os.path.join(HOME, "知識メモ")),
    ("scripts", os.path.join(HOME, "bin")),
    # 本体側の控えから外したぶん、こちらで取る。AGENTS.md がここにある
    # （道具を足したら書く場所なので、控えから漏らせない）。
    ("workspace", os.path.join(HOME, ".openclaw", "workspace")),
    # 2026-09-10 追加。控えを 点検したら、この2つはどこにも控えが無かった。
    # 未踏の提案書は git にも入っていないので、消えたら本当に終わりだった。
    ("未踏", os.path.join(HOME, "未踏")),
    ("文脈ゲートウェイ", os.path.join(HOME, "文脈ゲートウェイ")),
]

# **リモートの無い git は、.git そのものが履歴の唯一の控えになる。**
# 下の filt は既定で .git を落とすが（GitHub にあるものを二重に持たないため）、
# ここに挙げたものだけは .git ごと入れる。
# 文脈ゲートウェイはリモートが無く、外したら履歴が丸ごと消える。
KEEP_GIT = {"文脈ゲートウェイ"}

# 作業用の中間物。入れても復元の役に立たず、控えだけ重くなる。
SKIP_DIRS = {".git", "node_modules", "__pycache__", ".DS_Store",
             ".pdfenv", ".venv", "venv", "dist", "build", ".next", ".cache"}
EXTRA_FILES = [
    os.path.join(HOME, ".openclaw", "briefing-topics.txt"),
    os.path.join(HOME, ".openclaw", "openclaw.json"),
]


def log(msg):
    print(msg, flush=True)


def openclaw_backup(_stamp):
    """OpenClaw 本体のバックアップ。認証情報を含むので中身は触らない。
    --output に保存先ディレクトリを渡す。省略するとカレントに作られて散らばる。"""
    before = set(os.listdir(DEST)) if os.path.isdir(DEST) else set()
    try:
        p = subprocess.run(
            # **workspace は外す。**中に `~/知識メモ` を指すリンクがあり、
            # 2026.9.2 が「控えの外を指すリンク」を拒むようになったせいで、
            # 9/7 以降ずっと丸ごと失敗していた（気づくまで2日ぶん失われた）。
            # workspace の中身（AGENTS.md ほか）は下の TARGETS で別に取る。
            ["openclaw", "backup", "create", "--output", DEST, "--verify",
             "--no-include-workspace"],
            capture_output=True, text=True, timeout=900,
        )
        if p.returncode != 0:
            log(f"  OpenClaw のバックアップに失敗: {(p.stderr or p.stdout or '').strip()[:200]}")
            return None
    except FileNotFoundError:
        log("  openclaw コマンドが見つかりません")
        return None
    except Exception as e:
        log(f"  OpenClaw のバックアップに失敗: {e}")
        return None

    added = [f for f in os.listdir(DEST) if f not in before]
    if not added:
        return "(作成済み)"
    path = os.path.join(DEST, added[0])

    # **取れたことと、戻せることは別。**`--verify` は書いた直後に自分で見るが、
    # ここでもう一度、独立した口で確かめる。検証していない控えは控えではない。
    try:
        v = subprocess.run(["openclaw", "backup", "verify", path],
                           capture_output=True, text=True, timeout=600)
        if v.returncode != 0:
            log(f"  控えは書けたが、検証に落ちた: {(v.stderr or v.stdout).strip()[:160]}")
            return None
    except Exception as e:
        log(f"  控えの検証ができなかった: {e}")
        return None
    return path


def make_archive(stamp):
    """Obsidian と自作スクリプトを1つの tar.gz にまとめる。"""
    path = os.path.join(DEST, f"ai-env-{stamp}.tar.gz")
    n = 0
    with tarfile.open(path, "w:gz") as tar:
        for name, src in TARGETS:
            if not os.path.exists(src):
                continue
            # 巨大な中間物は入れない。.git は原則落とすが、
            # リモートの無いものだけは履歴ごと残す（KEEP_GIT）。
            def filt(ti, _name=name):
                base = os.path.basename(ti.name)
                if base == ".git":
                    return ti if _name in KEEP_GIT else None
                if base in SKIP_DIRS:
                    return None
                return ti
            tar.add(src, arcname=name, filter=filt)
            n += 1
        for f in EXTRA_FILES:
            if os.path.exists(f):
                tar.add(f, arcname=os.path.join("config", os.path.basename(f)))
                n += 1
    return path, n


def prune():
    if not os.path.isdir(DEST):
        return
    cutoff = datetime.now() - timedelta(days=KEEP_DAYS)
    removed = 0
    for name in os.listdir(DEST):
        p = os.path.join(DEST, name)
        if not os.path.isfile(p):
            continue
        if datetime.fromtimestamp(os.path.getmtime(p)) < cutoff:
            try:
                os.remove(p)
                removed += 1
            except OSError:
                pass
    if removed:
        log(f"{KEEP_DAYS}日より古いバックアップ {removed} 件を削除しました。")


def listing():
    if not os.path.isdir(DEST):
        log("バックアップはまだありません。")
        return
    files = sorted(
        (f for f in os.listdir(DEST) if os.path.isfile(os.path.join(DEST, f))),
        key=lambda f: os.path.getmtime(os.path.join(DEST, f)),
        reverse=True,
    )
    if not files:
        log("バックアップはまだありません。")
        return
    total = 0
    log(f"保存先: {DEST}")
    for f in files:
        p = os.path.join(DEST, f)
        sz = os.path.getsize(p)
        total += sz
        when = datetime.fromtimestamp(os.path.getmtime(p)).strftime("%Y-%m-%d %H:%M")
        log(f"  {when}  {sz/1024/1024:6.1f}MB  {f}")
    log(f"合計 {len(files)} 件 / {total/1024/1024:.1f}MB")


def main():
    if "--list" in sys.argv:
        listing()
        return 0
    if "--prune" in sys.argv:
        prune()
        return 0

    # 手入れ中は保存しない。**半分だけ変換された設定を「控え」として
    # 残すほうが、控えが1日欠けるより悪い。**戻したときに壊れた形に戻る。
    # --list と --prune は読むだけ／古いものを消すだけなので、ここより手前で帰る。
    held, why = maintenance()
    if held:
        log(f"手入れ中なので保存を見送りました（{why}）")
        return 0

    os.makedirs(DEST, exist_ok=True)
    stamp = datetime.now().strftime("%Y%m%d-%H%M")

    log("OpenClaw の設定と履歴を保存中…")
    oc = openclaw_backup(stamp)
    if oc:
        log(f"  → {oc}")

    log("Obsidian とスクリプトを保存中…")
    path, n = make_archive(stamp)
    sz = os.path.getsize(path) / 1024 / 1024
    log(f"  → {path} ({sz:.1f}MB, {n}件)")

    prune()

    # **片方が失敗しているのに「完了しました」と言わない。**
    # 2026-09-08 まで、本体側の控えが2日ぶん失敗し続けていたのに、
    # 最後の行はいつも「完了しました。」で終了コードも 0 だった。
    # 失敗を画面に出してはいたが、**その下で成功を宣言していた**ので、
    # 定時実行のログを見ても成功と区別が付かなかった。
    if not oc:
        log("⚠ 設定と履歴の控えは取れていません。上の理由を見てください。")
        log("  取れたのは Obsidian とスクリプトだけです。")
        return 1
    log("完了しました。")
    return 0


if __name__ == "__main__":
    sys.exit(main())
