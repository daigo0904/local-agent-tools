def cmd_通す(名):
    """~/bin の単体の道具を、そのまま走らせて終了コードを返す。

    **引数もそのまま渡す。**途中で削ると、`--all` や `--report` が
    黙って落ちて、呼んだ側には成功に見える。"""
    道具 = os.path.join(os.path.dirname(os.path.abspath(__file__)), 通す道具[名])
    if not os.path.exists(道具):
        print(f"  {通す道具[名]} が見つかりません: {道具}")
        return 1
    return subprocess.run([道具] + sys.argv[2:]).returncode


def cmd_hold():
    """手入れ中の印を置く・見る・外す。

    印には必ず期限がある。置いた人が消し忘れても、期限が来れば
    見張りは自分から戻る。**期限の無い停止を作らないこと**——
    それは「見張りを消した」のと同じで、消したことに誰も気づけない。"""
    args = [a for a in sys.argv[2:] if a.strip()]

    if not args:
        return show_hold()

    if args[0] in ("--off", "off", "解除"):
        held, why = maintenance()
        maintenance_clear()
        print(f"  ● 印を外しました（{why}）" if held else "  ○ もともと印はありません")
        return 0

    seconds = parse_span(args[0])
    if seconds is None:
        print(f"  時間の読み方が分かりません: {args[0]}")
        print("  例: claw hold 30m / claw hold 90s / claw hold 1h / claw hold 30")
        return 1
    why = " ".join(args[1:]).strip() or "手作業"

    capped = min(seconds, MAINT_MAX)
    if not maintenance_hold(why, seconds, "claw hold"):
        print("  ✗ 印を置けませんでした（書き込めない）")
        return 1
    print(f"  ● 印を置きました  {capped // 60}分（{why}）")
    if capped < seconds:
        print(f"     {seconds // 60}分と言われましたが、上限の {MAINT_MAX // 60}分にしました。")
        print("     期限の無い停止を作らないための上限です。")
    print()
    return show_hold()


