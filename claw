def start_ollama():
    if ollama_up():
        return True
    print("  … ollama を起こす")
    run(["brew", "services", "start", "ollama"])
    return wait_for(ollama_up, 30, "ollama の返事を待つ")


def start_gateway():
    if gateway_up():
        return True
    ok, out = run(["openclaw", "daemon", "start"])
    if not ok:
        print("  ! gateway を起こせなかった")
        if out:
            print("    " + out.replace("\n", "\n    "))
        return False
    return wait_for(gateway_up, 60, "gateway の起動を待つ")


def start_line():
    """LINE の常駐を、落ちているものだけ起こす。"""
    pids = launchd_pids()
    for label, name in LINE_SERVICES:
        if pids.get(label):
            continue
        plist = os.path.join(LAUNCH_AGENTS, f"{label}.plist")
        if not os.path.exists(plist):
            continue
        if label in pids:
            schedlib.蹴る(label, 殺す=True, path=plist)
        else:
            schedlib.入れる(label, plist)
        print(f"  … LINE の{name}を起こした")


def repair_tunnel():
    """LINE の入り口が切れていれば直す。中身は line-guard に任せる。"""
    reachable, _ = tunnel_ok()
    if reachable:
        return
    print("  … LINE の入り口が切れているので直す（1〜2分かかる）")
    subprocess.run(道具の呼び方([os.path.join(BIN, "line-guard"), "--report"]))


def self_running():
    """時計で勝手に走るもの。(名前, 実行ファイル) を返す。

    **一覧を手で書かない。**書いた一覧は、道具を1つ増やした日から嘘になる。
    launchd の登録そのものを見れば、増えても減っても勝手に追いつく。
    常駐（KeepAlive だけのもの）は時計で走らないので、ここには出さない。"""
    out = []
    try:
        names = sorted(os.listdir(AGENTS))
    except OSError:
        return out
    for fn in names:
        if not (fn.startswith("ai.openclaw.") and fn.endswith(".plist")):
            continue
        try:
            with open(os.path.join(AGENTS, fn), "rb") as f:
                p = plistlib.load(f)
        except Exception:
            continue
        if not (p.get("StartInterval") or p.get("StartCalendarInterval")):
            continue
        args = p.get("ProgramArguments") or []
        if not args:
            continue
        exe = os.path.expanduser(args[0])
        if os.path.dirname(exe) == BIN and os.path.isfile(exe):
            out.append((os.path.basename(exe), exe))
    return out


def show_hold():
    """いま印があるか、そして誰がそれを守るか。

    **守る側の一覧も実物から作る。**「足したはず」と実物がずれるのが
    この一式の壊れ方なので、ファイルを読んで確かめたものだけを ● にする。"""
    held, why = maintenance()
    print(f"  ● {why}" if held else "  ○ 印はありません（見張りはふつうに働きます）")
    if held:
        # 何がこの印を切るのか。**期限だけなのか、置き主の命もなのか。**
        # 置き主が死んでも切れない印は、死んだ分だけ見張りが黙り続ける。
        try:
            with open(MAINT_MARK) as f:
                m = json.load(f)
        except (OSError, ValueError):
            m = {}
        if m.get("tied"):
            print(f"     置き主（PID {m.get('pid', '?')}）が消えたら、期限を待たずに切れます")
        else:
            print("     期限が来るまで切れません（人が置いた印なので）")
    print()
    print("  時計で勝手に走るもの:")
    deaf = []
    for name, exe in self_running():
        if honors_mark(exe):
            print(f"    ● {name:<14} 印を見る")
        else:
            print(f"    ✗ {name:<14} 印を見ない")
            deaf.append(name)
    if deaf:
        print()
        print(f"  ✗ の {len(deaf)} 個は、印を置いても手を出してきます。")
        print("     手入れの前に止めるなら: " + _止め方())
    return 0


def parse_span(text):
    """「30m」「90s」「1h」「30」を秒にする。単位が無ければ分。読めなければ None。"""
    m = re.fullmatch(r"(\d+)\s*(s|m|h|秒|分|時間|時)?", text.strip())
    if not m:
        return None
    n, unit = int(m.group(1)), m.group(2)
    if unit in ("s", "秒"):
        return n
    if unit in ("h", "時間", "時"):
        return n * 3600
    return n * 60


# **claw の窓口ではない単体の道具。**`claw <名前>` でも通す。
#
# 2026-09-12 に実測して分かったこと。心拍のモデルは 09-11 までは
# `house-brief` と打っていたのに、09-12 からは `claw house-brief` に変えた。
# こちらは「知らないコマンド」で終了コード 1 を返すだけなので、
