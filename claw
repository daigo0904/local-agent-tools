WORK_WAIT_MAX = int(os.environ.get("CLAW_WORK_WAIT") or 35 * 60)


def running_cron():
    """いま走っている定時の仕事。(名前, 経過) の一覧。

    **プロセスでは見えない。**定時の仕事は gateway の中で走るので、
    `ps` に qwc のような独立したプロセスとしては現れない。記録のほうを見る。

    2026-09-08、`claw down` が qwc は待つのに定時は待たず、実行中だった
    心拍を切った（記録に `interrupted` が残っている）。"""
    try:
        con = sqlite3.connect(
            f"file:{os.path.expanduser('~/.openclaw/state/openclaw.sqlite')}?mode=ro",
            uri=True, timeout=5)
        rows = con.execute(
            "select coalesce(j.name, r.job_id), r.started_at_ms"
            "  from cron_run_receipts r left join cron_jobs j on j.job_id = r.job_id"
            " where r.status = 'running'").fetchall()
        con.close()
    except Exception:
        return []
    now = time.time() * 1000
    return [(n, ago((now - t) / 1000)) for n, t in rows]


def running_work():
    """いま走っている「頼まれ仕事」。(PID, 名前, 経過) の一覧。

    **実行ファイルの絶対パスが引数に立っているときだけ数える。**
    `ps` の出力には、その名前に言及しているだけの別のコマンド
    （このコマンド自身を含む）が混ざるので、部分一致で数えると必ず誤る。"""
    ok, out = run(["ps", "-Ao", "pid=,etime=,command="])
    if not ok:
        return []
    found = []
    for line in out.splitlines():
        parts = line.split(None, 2)
        if len(parts) < 3:
            continue
        pid, etime, cmd = parts
        words = cmd.split()
        for name in WORK_COMMANDS:
            if os.path.join(BIN, name) in words:
                found.append((pid, name, etime))
                break
    return found


def loaded_labels():
    """いま launchd に登録されている、この家のラベル。"""
    return [lb for lb in launchd_pids() if lb.startswith("ai.openclaw.")]


GATEWAY_LABEL = "ai.openclaw.gateway"


def bootout(label, name):
    """登録から外して、**消えたことを実物で確かめる**。

    `launchctl bootout` はすぐには返らない。外した直後に一覧を引くと
    まだ載っていることがあり、そこで「失敗」と書くと嘘になる
    （2026-09-08、LINE のトンネルを実際に外せていたのに失敗と報告した）。

    ラベルは**実行ファイル名から組み立てない**。`ai-backup` の登録名は
    `ai.openclaw.backup` で、名前がずれている。組み立てた名前で外すと
    存在しないものを外して、存在しないことを確かめて、緑を出す——
    外れていないのに成功と報告する、いちばん危ない形になる。"""
    import schedlib
    schedlib.外す(label)
    for _ in range(15):
        if label not in launchd_pids():
            say(OK, name)
            return True
        time.sleep(1)
    say(NG, name, "外れなかった")
    return False


def cmd_down():
    """家をまるごと止める。戻すのは claw up。"""
    if os.path.exists(DOWN_MARK):
        print("  もう止まっています。戻すなら claw up")
        return 0

    # 1. 走っている仕事の終わりを待つ。**殺さない。**
    #    頼まれ仕事（qwc など・プロセスで見える）と、
    #    定時の仕事（gateway の中で走る・記録でしか見えない）の両方。
    def busy():
        return ([f"{n}（{e} 経過・PID {p}）" for p, n, e in running_work()]
                + [f"{n}（{e} 経過・定時）" for n, e in running_cron()])

    work = busy()
    if work:
        print("  いま動いている仕事があります。終わるまで待ちます。")
        for line in work:
            print(f"    {line}")
        # 1秒刻みで見る。5秒刻みだと、終わった仕事を最大5秒待ち続けるうえ、
        # **短い上限で試せない**（上限を1秒にしても1回は5秒眠ってしまう）。
        # 試せない枝は、いざというときに「発火しませんでした」になる。
        waited = 0
        while waited < WORK_WAIT_MAX:
            time.sleep(1)
            waited += 1
            work = busy()
            if not work:
                break
            if waited % 30 == 0:
                print(f"    … {waited // 60}分{waited % 60}秒 待っています（{work[0]}）")
        if work:
            # 長さは ago() に任せる。分で割ると、短い上限で試したときに
            # 「0分待っても」と出て、訓練の出力が読めなくなる。
            print(f"  ! {ago(WORK_WAIT_MAX)}待っても終わりませんでした。**止めずに帰ります。**")
            print("    先にその仕事を終わらせてから、もう一度。")
            return 1
        print("  ● 仕事が終わりました")

    # 2. いまの形を控える。**戻すときはこの控えだけを見る。**
    #    「たぶんこれが動いていたはず」で戻すと、増やした道具が戻らない。
    state = {
        "at": datetime.now().isoformat(timespec="seconds"),
        "labels": loaded_labels(),
        "ollama": ollama_up(),
        "model": resident_model_note(),
        "ollama_env": ollama_env(),
    }
    if not atomic_write(DOWN_MARK, json.dumps(state, ensure_ascii=False, indent=2)):
        print("  ✗ 控えを書けませんでした。止めません（戻せなくなるため）")
        return 1
    print(f"  ● いまの形を控えました  登録 {len(state['labels'])} 件"
          + (f"・頭脳 {state['model']}" if state["model"] else ""))

    # 3. 見張りに手を出させない。**外す前に置く。**
    #    外し終わる前に見張りが走ると、止めたそばから起こしにくる。
    maintenance_hold("claw down で家を止めている", MAINT_MAX, "claw down")

    # 4. 何を外すかは**実物の登録から決める**。手で書いた一覧は、
    #    道具を1つ増やした日から嘘になる。
    line_labels = {lb for lb, _ in LINE_SERVICES}
    scheduled = [lb for lb in state["labels"]
                 if lb != GATEWAY_LABEL and lb not in line_labels]

    print("\n  見張りと定時のものを外す")
    for label in sorted(scheduled):
        bootout(label, label.replace("ai.openclaw.", ""))

    # 5. gateway → LINE → ollama。依存の下流から止める。
    #    **`openclaw daemon stop` では止まらない。**plist は落ちたら起こす設定なので、
    #    プロセスを止めても launchd がすぐ起こし直す。登録から外すのが正しい
    #    （2026-09-08、daemon stop で「止まらない」と出たのはこれが理由）。
    print("\n  本体と入り口を止める")
    bootout(GATEWAY_LABEL, "gateway")
    for _ in range(15):
        if not gateway_up():
            break
        time.sleep(1)
    if gateway_up():
        say(NG, "gateway", "登録は外れたが、ポートがまだ開いている")

    for label, nm in LINE_SERVICES:
        if label in state["labels"]:
            bootout(label, f"LINE の{nm}")

    print("\n  頭脳を降ろす")
    run(["brew", "services", "stop", "ollama"])
    for _ in range(30):
        if not ollama_up():
            break
        time.sleep(1)
    say(NG if ollama_up() else OK, "ollama",
        "止まらない" if ollama_up() else "止まった（17GB 空いた）")

    print()
    print("  家を止めました。戻すには:  claw up")
    return 0


def cmd_up():
    """claw down で止めた形に戻す。"""
    try:
        with open(DOWN_MARK) as f:
            state = json.load(f)
    except (OSError, ValueError):
        print("  止めた記録がありません。ふつうに立ち上げるなら claw")
        return 1

    print(f"  {state.get('at', '?')} に止めた形へ戻します\n")

    # 止めたときと逆順。上流（頭脳）から。
    print("  頭脳を載せる")
    # **戻すのは起こしたあと。**`brew services stop` は plist ごと消すので、
    # 止まっている間は書き戻す先が無い。`brew services start` が作り直してから、
    # そこへ書き足して、定義を読み直させる（2026-09-08 に順番を間違えた）。
    if not start_ollama():
        print("  ✗ ollama が上がりませんでした。ここで止めます（頭脳が無いと意味がない）")
        return 1
    say(OK, "ollama")

    # brew が作り直した plist に、手で足してあった設定を書き戻す。
    if restore_ollama_env(state.get("ollama_env")):
        schedlib.外す("homebrew.mxcl.ollama")
        time.sleep(2)
        schedlib.入れる("homebrew.mxcl.ollama", OLLAMA_PLIST)
        wait_for(ollama_up, 30, "ollama の載せ直しを待つ")

    # 届いたかを**プロセスの環境で**確かめる。plist に書いてあることは、
    # そのプロセスに渡っていることを意味しない（kickstart だと読み直さない）。
    want = state.get("ollama_env") or {}
    if want:
        ok_env, out = run(["bash", "-c",
                           "ps eww $(pgrep -f '[o]llama serve' | head -1)"])
        lost = [k for k, v in want.items() if f"{k}={v}" not in out]
        if lost:
            say(NG, "ollama に届いていない設定", " / ".join(lost))
            print("     手で: launchctl bootout gui/$(id -u)/homebrew.mxcl.ollama")
            print("           launchctl bootstrap gui/$(id -u) " + OLLAMA_PLIST)
        else:
            say(OK, "ollama の設定", " / ".join(f"{k}={v}" for k, v in want.items()))

    print("\n  本体と入り口を起こす")
    if not start_gateway():
        print("  ✗ gateway が上がりませんでした。claw log でログを見てください")
        return 1
    say(OK, "gateway", f"ポート {GATEWAY_PORT}")
    start_line()

    # 見張りは**最後**。起動中に走らせると、立ち上がりかけを障害と読む。
    print("\n  見張りと定時のものを戻す")
    now = launchd_pids()
    for label in state.get("labels", []):
        if label in now:
            continue
        plist = os.path.join(LAUNCH_AGENTS, f"{label}.plist")
        if not os.path.exists(plist):
            say(NG, label.replace("ai.openclaw.", ""), "plist が無い")
            continue
        schedlib.入れる(label, plist)
        back = label in launchd_pids()
        say(OK if back else NG, label.replace("ai.openclaw.", ""),
            "" if back else "戻せなかった")

    # 控えを消すのは**全部戻したあと**。途中で落ちたら、控えは残しておく。
    maintenance_clear()
    try:
        os.unlink(DOWN_MARK)
    except OSError:
        pass

    repair_tunnel()
    print()
    show_status()
    return 0


OLLAMA_PLIST = os.path.expanduser("~/Library/LaunchAgents/homebrew.mxcl.ollama.plist")


def ollama_env():
    """brew の plist に手で足してある環境変数。無ければ空。"""
    try:
        with open(OLLAMA_PLIST, "rb") as f:
            return dict(plistlib.load(f).get("EnvironmentVariables") or {})
    except Exception:
        return {}


def restore_ollama_env(want):
    """止める前にあった環境変数を戻す。戻したら True（＝積み直しが要る）。

    **`brew services start` は plist を作り直す。**手で足した
    `OLLAMA_CONTEXT_LENGTH=65536` はそこで消える。消えたことに気づかないと、
    広さを指定していない道具が既定値に落ちて、qwc を殺す
    （2026-08-31 の積み直し合戦がこれ）。2026-09-08、`claw up` が実際にこれを消した。

    **`launchctl kickstart` では戻らない。**あれは登録済みの定義を使うので、
    plist を書き換えても読み直さない。外して入れ直す必要がある。"""
    now = ollama_env()
    missing = {k: v for k, v in (want or {}).items() if now.get(k) != v}
    if not missing:
        return False
    try:
        with open(OLLAMA_PLIST, "rb") as f:
            d = plistlib.load(f)
        d.setdefault("EnvironmentVariables", {}).update(missing)
        with open(OLLAMA_PLIST, "wb") as f:
            plistlib.dump(d, f)
    except Exception as e:
        say(NG, "ollama の設定を戻せませんでした", str(e)[:80])
        return False
    say(OK, "ollama の設定を戻した", " / ".join(f"{k}={v}" for k, v in missing.items()))
    return True


def resident_model_note():
    """いま載っているモデルと広さ。載っていなければ None。"""
    try:
        with urllib.request.urlopen("http://127.0.0.1:11434/api/ps", timeout=3) as r:
            for m in json.loads(r.read()).get("models", []):
                return f"{m.get('name')}（{m.get('context_length')}）"
    except Exception:
        pass
    return None


