    args = [a for a in sys.argv[2:] if a.startswith("--")]
    return subprocess.run([os.path.expanduser("~/bin/openclaw-update"), *args]).returncode


# ---------------- 表示 ----------------


def health_lines():
    """openclaw health の頭のほう（Discord / LINE / 応答の速さ）だけ拾う。"""
    ok, out = run(["openclaw", "health"])
    if not ok:
        return []
    keep = []
    for line in out.splitlines():
        if line.startswith(("Discord:", "LINE:", "Gateway event loop:")):
            keep.append(line.strip())
    return keep


def show_status():
    # **止まっていることを、まず言う。**これを言わないと、下の「●が全部消えている」
    # 表を見た人が本物の障害だと読む。止めたのは自分だと分かるようにしておく。
    try:
        with open(DOWN_MARK) as f:
            d = json.load(f)
        print(f"\n  \033[33m■ この家は claw down で止めてあります"
              f"（{d.get('at', '?')} から）\033[0m")
        print("     戻すには: claw up\n")
    except (OSError, ValueError):
        pass

    print("OpenClaw の状態")

    say(OK if ollama_up() else NG, f"ollama    頭脳（{current_model()}）")

    up = gateway_up()
    say(OK if up else NG, f"gateway   本体（127.0.0.1:{GATEWAY_PORT}）")

    pids = launchd_pids()
    for label, name in LINE_SERVICES:
        alive = bool(pids.get(label))
        say(OK if alive else NG, f"LINE      {name}")

    # プロセスが生きていてもトンネルが切れていることがある（実際に10時間気づかなかった）
    reachable, note = tunnel_ok()
    say(OK if reachable else NG, "LINE      外からの入り口", note if not reachable else "")

    # 見張りたち。
    #
    # ここに出しているのは、3つが別々のプロセスで別々の時計で動いているから。
    # 1つにまとめると、そのファイルのバグ1つで全部が同時に黙り、
    # 互いを見張る意味が消える。散らばって見えるのは、そのための代償である。
    print()
    for name, label, limit in GUARDS:
        age = pulse_age(name)
        if age is None:
            say(NG, f"見張り    {label}", "動いていない")
        elif age > limit:
            say(NG, f"見張り    {label}", ago(age) + "止まっている")
        else:
            say(OK, f"見張り    {label}", ago(age) + "前")

    # 設定が「戻せる状態」にあるか。壊したときに戻せないのが一番困る。
    cg = os.path.expanduser("~/bin/config-guard")
    if os.path.exists(cg):
        r = subprocess.run(道具の呼び方([cg]), capture_output=True, text=True)
        good = "動いた形" in r.stdout and "まだ無い" not in r.stdout
        changed = "記録していない変更" in r.stdout
        if not good:
            say(NG, "設定      戻せる形がまだ無い", "config-guard --save")
        elif changed:
            say(OK, "設定      戻せる（未記録の変更あり）", "config-guard --diff")
        else:
            say(OK, "設定      戻せる")

    if up:
        print()
        for line in health_lines():
            print(f"    {line}")
        print(f"\n  管理画面: http://127.0.0.1:{GATEWAY_PORT}/  （claw ui で開く）")
        print("  話す:     claw chat")
    else:
        print("\n  立ち上げる: claw")


# ---------------- 各コマンド ----------------


def cmd_start():
    if gateway_up() and ollama_up():
        print("もう動いている。")
        print()
        show_status()
        return 0

    print("OpenClaw を立ち上げる")
    if not start_ollama():
        print("  ! ollama が上がらなかった。頭脳が無いので止まる。")
        return 1
    if not start_gateway():
        print("  ! gateway が上がらなかった。claw log でログを見る。")
        return 1
    start_line()
    repair_tunnel()
    print()
    show_status()
    return 0


def cmd_stop():
    ok, out = run(["openclaw", "daemon", "stop"])
    print("gateway を止めた。" if ok else f"止められなかった: {out}")
    print("（ollama と LINE の常駐はそのまま。まるごと止めるなら claw stop --all）")
    if "--all" in sys.argv:
        import schedlib
        for label, name in LINE_SERVICES:
            schedlib.外す(label)
            print(f"  LINE の{name}も止めた")
        run(["brew", "services", "stop", "ollama"])
        print("  ollama も止めた")
    return 0 if ok else 1


def cmd_restart():
    run(["openclaw", "daemon", "stop"])
    time.sleep(2)
    return cmd_start()


def cmd_log():
    if not os.path.exists(GATEWAY_LOG):
        print("まだログが無い。")
        return 1
    print(f"{GATEWAY_LOG}（Ctrl-C で抜ける）\n")
    try:
        subprocess.run(["tail", "-n", "40", "-f", GATEWAY_LOG])
    except KeyboardInterrupt:
        pass
    return 0


def cmd_chat():
    if not gateway_up():
        print("gateway が動いていないので、先に立ち上げる。")
        if cmd_start() != 0:
            return 1
        print()
    # Discord や LINE と同じ記憶を使う。--local にすると別の頭になるので使わない。
    return subprocess.run(["openclaw", "tui"]).returncode


def cmd_ui():
    if not gateway_up():
        print("gateway が動いていないので、先に立ち上げる。")
        if cmd_start() != 0:
            return 1
    return subprocess.run(["openclaw", "dashboard"]).returncode


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "start"
    table = {
        "start": cmd_start,
        "up": cmd_start,
        "status": show_status,
        "stop": cmd_stop,
        "down": cmd_stop,
        "restart": cmd_restart,
        "log": cmd_log,
        "logs": cmd_log,
        "chat": cmd_chat,
        "tui": cmd_chat,
        "ui": cmd_ui,
        "fix": cmd_fix,
        "update": cmd_update,
        "dashboard": cmd_ui,
        "hold": cmd_hold,
        "down": cmd_down,
        "up": cmd_up,
    }
    # 単体の道具への通し窓を足す（表に載せるのはここだけ）
    for 名 in 通す道具:
        table.setdefault(名, lambda 名=名: cmd_通す(名))
    if cmd in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    if cmd not in table:
        # **行き止まりにしない。**~/bin に同じ名前の道具があるなら、
        # 「それは claw の窓口ではない」と言うだけでは足りない。
        # 打った側（人でもモデルでも）が次に何を打てばよいか書く。
        隣 = os.path.join(os.path.dirname(os.path.abspath(__file__)), cmd)
        print(f"知らないコマンド: {cmd}\n")
        if os.path.exists(隣) and os.access(隣, os.X_OK):
            print(f"  それは claw の窓口ではなく、単体の道具です。")
            print(f"  そのまま打ってください: {cmd} " + " ".join(sys.argv[2:]))
            print(f"  （`claw {cmd}` で通したいなら、claw の 通す道具 に1行足す）\n")
        print(__doc__.strip())
        return 1
    return table[cmd]() or 0


if __name__ == "__main__":
    sys.exit(main())
