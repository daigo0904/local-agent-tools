# 写し損ねたので `notify` を作った、あれと同じ判断）。
# **文章の忠告は効かず、通る道を作るほうが効く。**
通す道具 = {
    "house-brief": "house-brief",     # 隙間を見て回る報せ（心拍が読む）
    "brief": "house-brief",
    "guardrun-sweep": "guardrun-sweep",   # 黙って終わった走りの掃除
