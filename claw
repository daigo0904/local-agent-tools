def current_model():
    """設定に書いてある「今使うモデル」を読む。設定を変えても表示がずれないように。"""
    try:
        with open(CONFIG) as f:
            d = json.load(f)
        name = d["agents"]["defaults"]["model"]["primary"]
        return name.split("/", 1)[-1]  # "ollama/gemma4:26b" -> "gemma4:26b"
    except Exception:
        return "?"


def tunnel_url():
    """cloudflared のログから今のトンネルURLを拾う。"""
    try:
        with open(TUNNEL_LOG, errors="ignore") as f:
            found = re.findall(r"https://[a-z0-9-]+\.trycloudflare\.com", f.read())
        return found[-1] if found else None
    except OSError:
        return None


def tunnel_ok():
    """LINE の入り口が生きているか。判定は line-guard に任せる。

    自分で curl してはいけない: この回線の DNS は *.trycloudflare.com を
    引けないので、生きていても必ず「切れている」と出る。
    line-guard は LINE 本人に webhook を叩いてもらって判定する。

    返り値: (生きているか, 説明)
    """
    ok, out = run([os.path.join(BIN, "line-guard"), "--check"])
    if ok and out.strip() == "OK":
        return True, ""
    return False, "LINEから届いていない（claw fix で直す）"


def ollama_up():
    try:
        with urllib.request.urlopen(OLLAMA_URL, timeout=3):
            return True
    except Exception:
        return False


def gateway_up():
    """ポートが開いているか。openclaw health より速くて、落ちていても待たされない。"""
    try:
        with socket.create_connection(("127.0.0.1", GATEWAY_PORT), timeout=2):
            return True
    except OSError:
        return False


def _止め方():
    """その機械での止め方を、実物の仕組みに合わせて言う。"""
    import schedlib
    s = schedlib.仕組み()
    if s == "launchd":
        return ("launchctl bootout gui/$(id -u)/ai.openclaw.<名前>"
                "（claw down なら全部まとめて）")
    if s == "systemd":
        return "systemctl --user stop ai.openclaw.<名前>（claw down なら全部まとめて）"
    return "この機械には常駐・定時の仕組みが無い（claw down は使えない）"


def launchd_pids():
    """登録されている仕事を { ラベル: PID または None } にする。

    **仕組み（launchd / systemd / 無し）は schedlib が知っている。**
    ここは名前で絞らない（ollama のように別の名前で登録されているものも見る）。"""
    import schedlib
    return schedlib.PID一覧(接頭=None)


def wait_for(check, seconds, note):
    """check() が True になるまで待つ。待っている間は点を打つ。"""
    for i in range(seconds):
        if check():
            if i:
                print()
            return True
        if i == 0:
            print(f"  … {note}", end="", flush=True)
        print(".", end="", flush=True)
        time.sleep(1)
    print()
    return False


