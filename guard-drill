        spec = importlib.util.spec_from_loader(
            "hb_claim", importlib.machinery.SourceFileLoader("hb_claim", path))
        hb = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(hb)
    except Exception as e:                               # noqa: BLE001
        return False, "house-brief を読み込めない（%s: %s）" % (type(e).__name__, e)
    for 名 in ("失敗の繰り返し", "やっていないのに言う", "連続失敗の上限", "完了語"):
        if not hasattr(hb, 名):
