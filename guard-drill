def drill_guardlib():
    """共有部品が壊れたとき、検査が気づくか（guardlib / modellib / netlib）。

    本物は触らない。写しを壊して、検査がそれを落とせるかだけ見る。
    ここが効かないと、共有にした代償を払っただけになる。"""
    tmp = tempfile.mkdtemp(prefix="drill-lib-")
    try:
        # guardlib は見張りが、modellib と netlib は道具がそれぞれ土台にしている。
        # どれも壊れると、乗っている側が丸ごと動かなくなる。
        for name in ("guardlib.py", "modellib.py", "netlib.py"):
            src = os.path.join(BIN, name)
            broken = os.path.join(tmp, name)
            shutil.copy2(src, broken)
            with open(broken, "a") as f:
                f.write("\ndef こわす(  # わざと壊す\n")
            r = run([sys.executable, broken, "--selftest"], timeout=60)
            if r is not None and r.returncode == 0:
                return False, f"{name}: 壊れているのに検査が通ってしまう"
            good = run([sys.executable, src, "--selftest"], timeout=60)
            if good is None or good.returncode != 0:
                return False, f"{name}: 本物の検査が通らない"
        return True, "壊れた写しは落ち、本物は通る（guardlib / modellib / netlib）"
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


