# ── 小道具 ────────────────────────────────────────────────
def width(text):
    """画面上の幅。日本語は2文字ぶん取るので、len では桁が揃わない。"""
    import unicodedata
    return sum(2 if unicodedata.east_asian_width(c) in "WF" else 1 for c in text)


def pad(text, to):
    return text + " " * max(0, to - width(text))


def say(mark, text, detail=""):
    print(f"  {mark} {pad(text, 24)}" + (f"  {detail}" if detail else ""), flush=True)


OK, NG, DOT = "\033[32m●\033[0m", "\033[31m●\033[0m", "\033[90m·\033[0m"


def run(args, timeout=120):
    """**家の道具は、その OS での呼び方に並べ直してから渡す。**"""
    args = 道具の呼び方(args)
    try:
        return subprocess.run(args, capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired):
        return None


def port_open(port):
    import socket
    try:
        with socket.create_connection(("127.0.0.1", port), timeout=2):
            return True
    except OSError:
        return False


def wait_until(fn, seconds, step=1.0):
    """条件が満たされるまで待つ。戻すときに必ず使う（待たずに次へ進まない）。"""
    end = time.time() + seconds
    while time.time() < end:
        if fn():
            return True
        time.sleep(step)
    return fn()


# 止める・動かすは、番号ではなく名前で送る。
#
# 番号を直書きしていて、macOS で一度も止められていなかった。
# macOS は SIGSTOP=17 / SIGCONT=19、Linux は SIGSTOP=19 / SIGCONT=18 と逆で、
# Linux の 19 を「止める」のつもりで送っていたので、実際には「動かす」だった。
# 訓練は何も壊さないまま「通った」と報告していた。
def proc_state(pid):
    r = run(["ps", "-p", str(pid), "-o", "state="])
    return (r.stdout.strip() if r and r.stdout else "")


def resume(pid, seconds=20):
    """止めた相手を動かし直す。**状態を見て、動くまで送り続ける。**

    一度送って終わりにしていたら、止まったまま「戻した」と報告していた。
    実際にそうなり、ollama がポートだけ握って答えない状態で残った。
    kickstart の嘘と同じ形で、確かめずに書いたのが原因である。"""
    if not pid:
        return True
    end = time.time() + seconds
    while time.time() < end:
        st = proc_state(pid)
        if not st:                       # もう居ない（誰かが入れ直した）
            return True
        if "T" not in st:                # 動いている
            return True
        try:
            os.kill(int(pid), signal.SIGCONT)
        except (OSError, ProcessLookupError):
            return True
        time.sleep(0.5)
    return "T" not in proc_state(pid)


def healthy():
    """いま一式が本当に動いているか。訓練の後始末はここが緑になるまで終わらない。

    **OK だけを正常とみなしてはいけない。**
    model-guard --check は3通り返す。

        OK    … 1トークン返せた
        SKIP  … 誰かの依頼を処理中なので点検を見送った
        NG    … 返ってこない

    ここは長らく `startswith("OK")` しか見ておらず、SKIP を「壊れている」と
    読んでいた。ollama は同時1件しか処理しないので、**誰かが使っている間は
    必ず SKIP になる**。つまり普通に使われている時間帯に訓練が走ると、
    何も壊れていないのに「訓練が壊したまま戻っていない。手で見ること」と
    出る。しかも使われているかどうかで結果が変わるので、日によって出たり
    出なかったりする。

    後始末の確認は「訓練が傷を残したか」を見る場所で、ここが理由もなく
    赤くなると、**本当に傷が残った日に信じてもらえなくなる**。
    SKIP は誰かが実際にモデルを使えているということなので、
    むしろ動いている証拠として扱う。"""
    r = run([os.path.join(BIN, "model-guard"), "--check"], timeout=300)
    if not r or not r.stdout.startswith(("OK", "SKIP")):
        return False
    return port_open(GATEWAY_PORT)


def lock_free(guard_name):
    """その見張りの鍵が空いているか。

    相手が止まっているあいだ、定期実行の見張りは点検の時間切れ（最大90秒）
    ずっと鍵を握る。訓練が同じ時間に呼ぶと、黙って引き返したぶんを
    「試した」と数えてしまい、8回呼んで1回も動いていない状態になった。"""
    try:
        f = open(os.path.join(OPENCLAW, f"{guard_name}.lock"), "w")
        取れた = 鍵を試す(f)
        if 取れた:
            鍵を返す(f)
        f.close()
        return 取れた
    except OSError:
        return False


def poke_until_noticed(guard_name, mark, args, seconds, env=None):
    """見張りが記録を残すまで、鍵の空いた隙に呼び続ける。

    記録が伸びれば、誰が呼んだぶんでもよい（定期実行が先に気づくこともある）。
    見たいのは「この故障に見張りが気づいたか」であって、呼び出し元ではない。"""
    end = time.time() + seconds
    while time.time() < end:
        if log_lines(guard_name) > mark:
            return True
        if lock_free(guard_name):
            subprocess.run(args, capture_output=True, timeout=300,
                           env=env or os.environ)
        else:
            time.sleep(3)
    return log_lines(guard_name) > mark


def poke_until_line(guard_name, mark, args, want, seconds):
    """見張りが、その一行を書くまで呼び続ける。

    「記録が伸びたか」だけで待つと、途中の『連続1回』が出た時点で
    次へ進んでしまい、手当てまで見届けられない（実際に16秒で落ちた）。
    見たいのは特定の結末なので、その言葉が出るまで待つ。"""
    end = time.time() + seconds
    while time.time() < end:
        try:
            with open(os.path.join(OPENCLAW, "logs", f"{guard_name}.log")) as f:
                if any(want in l for l in f.readlines()[mark:]):
                    return True
        except OSError:
            pass
        if lock_free(guard_name):
            subprocess.run(args, capture_output=True, timeout=300)
        else:
            time.sleep(3)
    return False


def log_lines(guard_name):
    """その見張りの記録の行数。訓練の前後で比べて、気づいたかを見る。"""
    try:
        with open(os.path.join(OPENCLAW, "logs", f"{guard_name}.log")) as f:
            return len(f.readlines())
    except OSError:
        return 0


def noticed(guard_name, before, want):
    """訓練のあいだに、その見張りが本当に気づいて動いたか。

    **ここが訓練の本体である。**サービスが戻ったことだけを見ていると、
    こちらが後始末で戻したぶんを「見張りが直した」と取り違える。
    実際そうなり、見張りが1行も記録していないのに「通った」と表示した。

    さらに悪いことに、gateway の合否にポートの開閉を使っていた。
    止めたプロセスもポートは握ったままなので、必ず「開いている」と出る。
    **この一式が存在する理由そのものを、訓練の中で間違えていた。**
    """
    try:
        with open(os.path.join(OPENCLAW, "logs", f"{guard_name}.log")) as f:
            new_lines = f.readlines()[before:]
    except OSError:
        return False, "記録が読めない"
    hit = [l for l in new_lines if any(w in l for w in want)]
    if not hit:
        return False, "見張りが気づいた形跡がない（記録に1行も出ていない）"
    return True, hit[-1].strip()


def set_pulse(name, minutes_ago):
    p = os.path.join(PULSE_DIR, f"{name}.json")
    at = datetime.fromtimestamp(time.time() - minutes_ago * 60)
    atomic_write(p, json.dumps({"at": at.isoformat(timespec="seconds")}))


class keep_state:
    """訓練のあいだ、その見張りの覚え書きを預かって、終わったら戻す。

    **訓練は本物の見張りに偽の故障を見せる。** 見張りは正直に数えるので、
    「連続13回失敗している」「05:30から落ちたままだ」という嘘が
    本物の覚え書きに残っていた（実際 fails:13 / down_since:05:30 が残っていた）。
    次に本物の障害が起きたとき、その数字から始まることになる。

    壊す前に戻し方を決める、という訓練の決まりは、
    **サービスだけでなく見張りの記憶にも要る**。"""

    def __init__(self, *names):
        self.paths = [os.path.join(OPENCLAW, f"{n}-state.json") for n in names]
        self.saved = {}

    def __enter__(self):
        for p in self.paths:
            try:
                with open(p) as f:
                    self.saved[p] = f.read()
            except OSError:
                self.saved[p] = None
        return self

    def __exit__(self, *exc):
        for p, body in self.saved.items():
            if body is None:
                try:
                    os.unlink(p)
                except OSError:
                    pass
            else:
                atomic_write(p, body)
        return False


def clear_kick_budget():
    """「さっき蹴ったばかり」の記録を消す。

    見張りは同じ相手を5分に1回しか蹴らないようにしてある（蹴り合いを止めるため）。
    訓練はそのすぐ後に「蹴るはず」を確かめるので、予算が残っていると
    **直っているのに落ちた**と報告してしまう。壊すのと同じで、
    訓練のためにここを空けるのは、訓練の一部として明示しておく。"""
    try:
        os.unlink(KICK_FILE)
    except OSError:
        pass


def wait_out_settling(limit=420):
    """寝起きの猶予が明けるまで待つ。明けたら True。

    見張りは寝起きのあいだ「古い心拍」で判断しない（寝ている間は誰も
    心拍を打てないので、古くて当たり前だから）。訓練はまさにその
    「古い心拍」を作って試すので、猶予中に走らせると必ず見送りになる。

    **ここは見送らずに待つ。** 訓練は毎日05:30に走るが、
    launchd の定時実行は**寝ていたMacを起こして走る**ので、
    「起きたばかり」は例外ではなく**毎日の普通の状態**になる。
    見送りで済ませると、いちばん確かめたい2つ（心拍の相互監視と、
    両方同時に倒れる形）が**毎日素通り**して、しかも緑の●で「通った」と出る。
    それは見張りが「直した」と嘘をつくのと同じ形なので、待つほうを選ぶ。

    猶予は5分なので、7分待てば足りる。それでも明けないなら素直に見送る。"""
    if not settling():
        return True
    return wait_until(lambda: not settling(), limit, 5)


# ── 訓練 ──────────────────────────────────────────────────
# 返すのは (通ったか, 説明)。どの訓練も、壊した状態で return しない。

def drill_pulse():
    """心拍を巻き戻して、相互監視が相手を蹴り起こすか。"""
    if not wait_out_settling():
        return True, "寝起きの猶予が明けないので見送り"
    before = pulse_age("model-guard")
    clear_kick_budget()
    set_pulse("model-guard", 30)
    r = run([os.path.join(BIN, "watchdog"), "--report"], timeout=180)
    if r is None:
        return False, "watchdog が返ってこない"
    if "30分止まっている" not in r.stdout:
        return False, f"止まっているのに気づかない（{r.stdout.splitlines()[0] if r.stdout else '出力なし'}）"
    # 蹴った結果、心拍が新しくなっているはず
    if not wait_until(lambda: (pulse_age("model-guard") or 999) < 120, 60):
        return False, "気づいたが、蹴っても心拍が戻らない"
    return True, f"気づいて蹴り起こした（前回は {int(before or 0)} 秒前）"


def drill_standoff():
    """**両方の心拍を同時に巻き戻して、蹴り合いにならないか。**

    2026-08-31、これが起きて23分止まった。Mac が32分寝て、起きた瞬間に
    watchdog と model-guard の心拍が同時に古くなった。そこから、

        watchdog    → model-guard を kickstart -k（走っていれば殺す）で蹴る
        model-guard → watchdog    を同じやり方で蹴る

    どちらも起動直後に相手を蹴るので、**どちらも心拍を書く前に殺され続けた**。
    心拍が新しくならないから、相手からは永久に死んで見える。
    50回ずつ「蹴った（成功）」と記録しながら、一度も直っていなかった。

    **この訓練が無かったから、見逃した。**
    それまでの訓練（drill_pulse）は片方の心拍しか巻き戻していない。
    片方だけなら、蹴られた側は普通に起きて心拍を書くので、何も起きない。
    実際に困るのは**両方が同時に倒れたとき**で、そちらは一度も試していなかった。
    寝て起きれば毎回そうなるので、珍しい形でもなかった。

    ## ここで手を出さないこと

    最初に書いたとき、心拍を戻したあと**両方を手で走らせて**から見ていた。
    それだと手で走らせたぶんが必ず心拍を書くので、**どう転んでも通る訓練**になる。
    1秒・0回で「通った」と出て、危ない道を一度も通っていなかった。
    この一式が扱っている問題（直っていないのに直ったと書く）が、
    訓練の中で再現していたことになる。

    倒したあとは launchd の定期実行に任せて、**待って見るだけ**にする。
    見るのは2つ。
      1. 両方の心拍が、決めた時間内に戻ること（＝抜け出せる）
      2. そのあいだに「相手が止まっている」と判断した回数が常識の範囲であること
         （事故のときは8分で約100回だった。正常なら数回で収まる）
    """
    if not wait_out_settling():
        return True, "寝起きの猶予が明けないので見送り"

    clear_kick_budget()
    marks = {n: log_lines(n) for n in ("model-guard", "watchdog")}

    # 寝起きと同じ形を作る。どちらも「止まっている」と判断される古さにする。
    set_pulse("model-guard", 30)
    set_pulse("watchdog", 30)

    # **ここから手を出さない。** 1分おきの定期実行だけで抜け出せるかを見る。
    # 抜け出せるなら2巡（2分）で戻る。5分待って戻らないなら殴り合っている。
    t0 = time.time()
    got_out = wait_until(
        lambda: (pulse_age("model-guard") or 9999) < 120
        and (pulse_age("watchdog") or 9999) < 120, 300, 5)
    took = int(time.time() - t0)

    # 「相手が止まっている」と判断した回数を数える。蹴ったかどうかではなく、
    # **何回そう判断したか**を見る（蹴らずに見送った回も、判断は起きている）。
    alarms = 0
    for name, mark in marks.items():
        try:
            with open(os.path.join(OPENCLAW, "logs", f"{name}.log")) as f:
                alarms += sum(1 for l in f.readlines()[mark:]
                              if "止まっている" in l or "心拍が無い" in l)
        except OSError:
            pass

    if not got_out:
        return False, (f"両方が同時に倒れると抜け出せない"
                       f"（5分待っても心拍が戻らない・この間に {alarms} 回さわいでいる）")
    if alarms > 6:
        return False, (f"{took}秒で抜け出せたが、{alarms} 回さわいでいる"
                       f"＝互いを死んだと読み続けている")
    return True, f"両方同時に倒れても {took}秒 で戻った（さわいだのは {alarms} 回）"


def drill_interval():
    """**plist に書いてある間隔と、コードが思っている間隔が合っているか。**

    見張りのしきい値は「何回続けてダメだったら」で書いてある。
    その回数は「何分待ちたいか」÷「何秒おきに走るか」で決めた数なので、
    plist の間隔を変えると、**コードを一行も触っていないのに待ち時間が変わる**。

    実際こうなっていた（2026-08-31 に発見）。

        watchdog    説明文「5分おき」・定数の注「3分おき」・plist 60秒
        model-guard 段取りの注「2分おき」・見送りの注「60秒おき」・plist 60秒

    そのせいで「答えないなら6分待つ」と書いてある gateway の入れ直しが、
    実際には**2分**で動いていた。冷えたモデルの読み込みだけで36秒かかるのに、
    一度の遅れで殺さないための余裕が1/3しか無かったことになる。
    数字が3つに割れていても、誰も落ちないので気づけない。だからここで数える。
    """
    # **間隔は窓口から取る。**plist を直に読むと、その仕組みが無い機械では
    # 中身の食い違いではなく「plist が読めない」で落ちる（2026-09-23、Linux で実際に）。
    import schedlib
    台帳 = schedlib.一覧()
    bad = []
    checked = []
    for label, script in (("ai.openclaw.model-guard", "model-guard"),
                          ("ai.openclaw.watchdog", "watchdog")):
        c = 台帳.get(label)
        if not c:
            bad.append("%s: %s に登録されていない（この機械では間隔を確かめられない）"
                       % (script, schedlib.仕組み() or "常駐・定時の仕組みが無い"))
            continue
        want = c.get("間隔")
        got = None
        try:
            for line in open(os.path.join(BIN, script)):
                if line.startswith("INTERVAL_S"):
                    got = int(line.split("=", 1)[1].split("#")[0].strip())
                    break
        except (OSError, ValueError):
            pass
        if got is None:
            bad.append(f"{script}: コードに INTERVAL_S が無い")
        elif want != got:
            bad.append(f"{script}: plist は {want}秒 なのにコードは {got}秒 のつもり")
        else:
            checked.append(f"{script}={got}秒")
    if bad:
        return False, " / ".join(bad)
    return True, "登録とコードの間隔が一致（" + " ".join(checked) + "）"


