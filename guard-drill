def drill_budget():
    """**外へ出た知らせは取り消せない。**だから出る量に予算があるか。

    プロセスを巻き戻しても、届いた通知は消えない。**副作用だけがロールバックできない。**
    2026-09-13、点呼の誤報で1日262回知らせを出した（平常時にログへ出る通知は
    1日4〜12件）。知らせが多すぎると読まれなくなるので、**黙るのと同じ害**になる。

    見るのは5つ。**「止める」だけでは足りない**——止めたことが見えなければ、
    予算そのものが黙らせる装置になる。

        通るべき側  予算の内なら、素通しで出る
        止まる      予算を超えたら出ない
        黙らせない  抑えたぶんが、各見張りの記録に1行ずつ残る
        知らせる    上限に達したことを **1回だけ** 外へ出す
        次の窓      抑えた件数を、窓が変わったときに伝える

    本物は1通も送らない（送る口を差し替えて数えるだけ）。置き場も使い捨て。"""
    import importlib
    sys.path.insert(0, BIN)
    try:
        import guardlib as GL
        GL = importlib.reload(GL)
    except Exception as e:                               # noqa: BLE001
        return False, "guardlib を読み込めない（%s）" % type(e).__name__
    if not hasattr(GL, "送信の予算"):
        return False, "guardlib に送信の予算が無い（外へ出る量に上限がない）"

    # **期待値を、試験する相手から借りない。**
    # 最初は「予算 + 5 回呼んで、予算ぶん出るか」だけを見ていた。
    # それだと `送信の予算 = 99999` に書き換えても訓練は通る——
    # **訓練がその 99999 を正しい値として使う**からである（実測で確認）。
    # だから幅は、こちらが実測から持つ。
    #
    #   下限 5   平常時にログへ出る通知は1日4〜12件。本物の事故を止めないため
    #   上限 60  暴走の実測は1時間63件（2026-09-12 22時）。ここを越えると止まらない
    予算 = GL.送信の予算
    if not 5 <= 予算 <= 60:
        return False, ("1時間の上限が %d 通。平常時は1日4〜12件、暴走の実測は"
                       "1時間63件なので、5〜60 の外だと**止めないか、事故を止める**"
                       % 予算)

    元 = (GL.BUDGET_FILE, GL.LOG_DIR, GL.DRILL_MARK, GL.env_value)
    tmp = tempfile.mkdtemp(prefix="drill-budget-")
    try:
        GL.BUDGET_FILE = os.path.join(tmp, "budget.json")
        GL.LOG_DIR = os.path.join(tmp, "logs")
        GL.DRILL_MARK = os.path.join(tmp, "印は置かない")
        GL.env_value = lambda k: "dummy"
        os.makedirs(GL.LOG_DIR, exist_ok=True)
        g = GL.Guard("予算の試験")
        g.log_path = os.path.join(GL.LOG_DIR, "予算の試験.log")
        出た = []
        g._post = lambda tok, ch, text: (出た.append(text), True)[1]
        g._flush_pending = lambda tok, ch: 0

        # **数えるものを、前置きで見分けられるようにする。**
        # 最初は本文を「知らせ N」にしていたが、上限を伝える文も
        # 「知らせが1時間で…」で始まるので、**本物に数えてしまった**。
        # 数える対象が前置きで決まるなら、前置きを重ねないこと。
        印 = "〈試験〉"
        for i in range(予算 + 5):
            g.notify("%s%d 通目" % (印, i + 1))
        本物 = [t for t in 出た if t.startswith(印)]
        予告 = [t for t in 出た if "超えました" in t]
        if len(本物) != 予算:
            return False, "%d 回呼んで %d 通出た（予算 %d のはず）" % (予算 + 5, len(本物), 予算)
        if len(予告) != 1:
            return False, ("上限に達した知らせが %d 通（1通だけが正しい）。"
                           "0 なら抑えたこと自体が黙る、2以上なら騒音" % len(予告))
        try:
            b = json.load(open(GL.BUDGET_FILE))
        except (OSError, ValueError):
            return False, "予算の記録が読めない"
        if b.get("抑えた") != 5:
            return False, "抑えた本数が %s（5 のはず）" % b.get("抑えた")
        try:
            記録 = open(g.log_path).read()
        except OSError:
            return False, "抑えたぶんの記録が1行も書かれていない（**黙って捨てている**）"
        残り = 記録.count("予算を超えたので送らなかった")
        if 残り != 5:
            return False, ("抑えたぶんの記録が %d 行（5 行のはず）。"
                           "**黙って捨てている**" % 残り)

        # 窓が変わったら、抑えた件数を伝えるか
        b["窓"] = time.time() - GL.送信の窓 - 1
        with open(GL.BUDGET_FILE, "w") as f:
            json.dump(b, f)
        出た.clear()
        g.notify(印 + "次の窓の1通目")
        伝えた = [t for t in 出た if "前の1時間で" in t and "5 件" in t]
        if not 伝えた:
            return False, ("窓が変わっても、抑えた 5 件を伝えなかった"
                           "（抑えたことが黙りになる）")
        if not any(t.startswith(印) for t in 出た):
            return False, "窓が変わったのに、次の1通目が出なかった"
    finally:
        GL.BUDGET_FILE, GL.LOG_DIR, GL.DRILL_MARK, GL.env_value = 元
        shutil.rmtree(tmp, ignore_errors=True)
        importlib.reload(GL)

    # 配線。予算があっても、notify が通っていなければ効かない。
    try:
        src = open(os.path.join(BIN, "guardlib.py")).read()
    except OSError:
        return False, "guardlib.py を読めない"
    本体 = src.split("def notify", 1)[-1].split("\n    def ", 1)[0]
    if "_予算" not in 本体:
        return False, "notify が予算を見ていない（上限はあるが効かない）"

    return True, ("予算 %d 通で止まり、超えたぶん 5 件は記録に残り、"
                  "上限は1回だけ知らせ、窓が変わったら件数を伝えた"
                  "（本物は1通も送っていない）" % GL.送信の予算)


