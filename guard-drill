        return False, "300秒で返らなかった＝guardrun が固まった（最後に通ったもの: %s）" % 最後[0][:60]
    except Exception as e:                               # noqa: BLE001
        return False, "印の試験を呼べなかった（%s）" % type(e).__name__
    try:
        要約 = json.loads([x for x in p.stdout.splitlines() if x.startswith("{")][-1])
    except (IndexError, ValueError):
        return False, "印の試験の結果が読めない: %s" % (p.stdout + p.stderr)[-160:]
    if 要約["落ちた"]:
        return False, "%d/%d 通過・落ちた: %s" % (要約["通った"], 要約["全部"], "／".join(要約["落ちた"][:6]))
    # **対話の Ctrl-C / Ctrl-Z が中へ届くかも回す。**（2026-09-24・M7）pty で端末を作って送る。
    対話 = os.path.join(BIN, "guardrun-対話の試験")
    if os.path.exists(対話) and not sys.platform.startswith("win"):
        try:
            q = subprocess.run([sys.executable, 対話, os.path.join(BIN, "guardrun.py")], capture_output=True,
                               text=True, timeout=180, stdin=subprocess.DEVNULL)
        except Exception as e:                           # noqa: BLE001
            return False, "対話の試験を呼べなかった（%s）" % type(e).__name__
        if q.returncode != 0:
            return False, "対話の Ctrl-C/Ctrl-Z が中へ届かない: %s" % q.stdout.strip()[-160:]
    # **Windows の用意の試験も一緒に回す。**（2026-09-24・C2）実機が無くても差し替えで回る。
    for 窓 in (os.path.join(BIN, "guardrun-窓の用意の試験"), os.path.join(BIN, "guardrun-窓のCPUの試験")):
        if not os.path.exists(窓):
            continue
        try:
            q = subprocess.run([sys.executable, 窓], capture_output=True, text=True, timeout=120,
                               stdin=subprocess.DEVNULL, env=dict(os.environ, PYTHONPATH=BIN))
        except Exception as e:                           # noqa: BLE001
            return False, "%s を呼べなかった（%s）" % (os.path.basename(窓), type(e).__name__)
        if q.returncode != 0:
            return False, "%s が落ちた: %s" % (os.path.basename(窓), (q.stdout + q.stderr).strip()[-160:])
    return True, "%d 通りすべて本当の終わり方どおりの印（偽造・消去・FIFO・リンク・壁が立たない を含む）" % 要約["全部"]


DRILLS = [
    ("pulse",    "心拍の相互監視",       drill_pulse,    False),
    ("claim",    "やっていないのに言う", drill_claim,    False),
    ("miscopy",  "識別子の写し損ね",     drill_miscopy,  False),
    ("budget",   "外へ出る量の上限",     drill_budget,   False),
    ("beacon",   "外の証人が居るか",     drill_beacon,   False),
    ("heal",     "直す者が手を消さないか", drill_heal,    False),
    ("rewrite",  "戻したそばから書き直される", drill_rewrite, False),
    ("keep",     "守りの設定が消えないか", drill_keep,   False),
    ("silence",  "黙りが見えるか",       drill_silence,  False),
    ("spin",     "空回りの見分け",       drill_spin,     False),
    ("standoff", "両方同時に倒れる",     drill_standoff, False),
    ("interval", "間隔の食い違い",       drill_interval, False),
    ("notify",   "知らせが届く先",       drill_notify,   False),
    ("lock",     "二重に走らない鍵",     drill_lock,     False),
    ("guardlib", "共有部品の検査",       drill_guardlib, False),
    ("qwc",      "コードを書く側の故障", drill_qwc,      False),
    ("thrash",   "積み直しの取り合い",   drill_thrash,   False),
    ("busy",     "働いているかの見分け", drill_busy,     False),
    ("escape",   "壁から抜け出せるか",   drill_escape,   False),
    ("limits",   "量と時間の上限",       drill_limits,   False),
    ("silent",   "黙って終われないこと", drill_silent,   False),
    ("walled",   "壁が使われているか",   drill_walled,   False),
    ("marks",    "受領証の印が正直か",   drill_marks,    False),
    ("ollama",   "頭脳を止めて復旧",     drill_ollama,   True),
    ("gateway",  "受け口を黙らせて復旧", drill_gateway,  True),
    ("config",   "設定を壊して巻き戻す", drill_config,   True),
]


def main():
    args = [a for a in sys.argv[1:] if not a.startswith("-")]
    flags = {a for a in sys.argv[1:] if a.startswith("-")}

    if "--list" in flags:
        print("試せるもの:\n")
        for name, title, _, heavy in DRILLS:
            print(f"  {name:9} {title}" + ("   ※ サービスが一時的に止まる" if heavy else ""))
        print("\n  既定では ※ 印は走らせない。--full で全部。")
        print("  --quiet … 通れば何も言わない（定時実行用）")
        return 0

    # 定時に走らせるときは、通ったことをいちいち言わない。
    # 落ちたぶんだけは、記録に残るよう画面にも出す（launchd がログに書く）。
    quiet = "--quiet" in flags

    chosen = [d for d in DRILLS if (d[0] in args) or (not args and (not d[3] or "--full" in flags))]
    if not chosen:
        print("その名前の訓練はありません。--list で一覧。")
        return 1

    if "--dry-run" in flags:
        print("走らせるもの:")
        for name, title, _, heavy in chosen:
            print(f"  {name:9} {title}" + ("   ※ 一時的に止まる" if heavy else ""))
        return 0

    # 手入れ中は訓練しない。**この道具は「わざと壊す」側**なので、
    # 直している最中に走ると、直している人の隣で別のものを壊すことになる。
    # 05:30 に走るぶん、朝の手入れと重なりやすい。
    # `--list` と `--dry-run` はここより手前で帰るので、見るだけなら手入れ中でも通る。
    held, why = stand_down(G)
    if held:
        state = G.load_state()
        skips = int(state.get("skips", 0)) + 1
        state["skips"] = skips
        G.save_state(state)
        if not quiet:
            print(f"  {why}")
            print("  訓練は見送りました。手入れが終わってから走らせてください。")
        # **見送りっぱなしにはしない。**心拍は見送った回にも残るので、
        # watchdog から見ると「通った日」と見分けが付かない。
        # 黙って見送り続けると、**訓練が止まっていることに誰も気づけなくなる**——
        # この一式がいちばん嫌う「壊れているのに壊れていると言わない」形そのもの。
        if skips >= SKIP_MAX:
            G.tell_once(state, "skip_told",
                        f"見張りの訓練を {skips} 回続けて見送っています"
                        f"（毎回、手入れ中の印が置かれていました）。\n"
                        f"訓練が走っていないので、**見張りが本当に働くかは確かめられていません**。\n"
                        f"  claw hold      … 誰が印を置いているか見る\n"
                        f"  guard-drill    … 手で1回走らせる")
        return 0

    # 訓練中の印。あとで記録を読む人が、本物の障害と取り違えないため。
    with open(MARK_FILE, "w") as f:
        json.dump({"at": datetime.now().isoformat(timespec="seconds"),
                   "drills": [d[0] for d in chosen]}, f, ensure_ascii=False)
    G.log("訓練を始めた: " + ", ".join(d[0] for d in chosen))

    if not quiet:
        print(f"\n見張りの訓練（{len(chosen)} 項目）\n", flush=True)
    results, stopped = [], False
    try:
        for i, (name, title, fn, heavy) in enumerate(chosen):
            if not quiet:
                print(f"  {DOT} {title} …", end="", flush=True)
            try:
                sys.stdout.flush()
            except BrokenPipeError:
                pass
            t0 = time.time()
            try:
                ok, detail = fn()
            except Exception as e:                       # noqa: BLE001
                ok, detail = False, f"訓練そのものが失敗した（{type(e).__name__}: {e}）"
            if not quiet:
                print("\r\033[K", end="", flush=True)
            if ok is None:
                # **測っていない。**通った数にも落ちた数にも入れない。
                # 走らなかった項目と同じ扱いになる（下で名指しされる）。
                if not quiet:
                    print("\r\033[K", end="", flush=True)
                    say(DOT, title, f"測れなかった — {detail}")
                G.log(f"{name}: 測れなかった — {detail}")
                continue
            if not quiet or not ok:
                say(OK if ok else NG, title, f"{detail}（{int(time.time()-t0)}秒）")
            results.append((name, title, ok, detail))
            G.log(f"{name}: {'通った' if ok else '落ちた'} — {detail}")
            if not ok:
                # **落ちたから止める、はやめた（2026-09-13）。**
                #
                # 判定が赤いだけなら、この項目は何も壊していない——
                # 「見つけた」と言っているだけである。そこで打ち切ると、
                # 直すまでの間ずっと後ろの項目が走らなくなる。
                #
                # 止めるのは**家が実際に傷んだとき**だけ。訓練はサービスを
                # 壊すので、壊れたまま次の訓練を走らせると傷が重なる。
                # 判断は後始末と同じ `healthy()` に任せる（物差しを2つ持たない）。
                # 一発で見ずに少し待つのは、ollama が誰かの依頼を処理中だと
                # 一時的に赤くなるため（後始末の確認と同じ理由）。
                if not wait_until(healthy, 60, 5):
                    stopped = True
                    残り = [t for _, t, _, _ in chosen[i + 1:]]
                    if not quiet:
                        say(NG, "ここで止めた",
                            "家が傷んでいるので残りは走らせない"
                            + (f"（残り {len(残り)} 項目）" if 残り else ""))
                    G.log("家が傷んだのでここで止めた（残り %d 項目）" % len(残り))
                    break
    finally:
        try:
            os.remove(MARK_FILE)
        except OSError:
            pass
        G.beat()

    # 訓練が傷を残していないかを、合否に含める。
    #
    # 「壊れ方を見つけられたか」だけを見ていたら、ollama を止めたまま
    # 「2項目すべて通りました」と表示した。訓練が一番の障害要因になる、
    # というのがまさにこれで、後始末まで見ないと合格とは呼べない。
    if not quiet:
        print(f"  {DOT} 後始末の確認 …", end="", flush=True)
        sys.stdout.flush()
    left_ok = wait_until(healthy, 180, 5)
    if not quiet:
        print("\r\033[K", end="", flush=True)
    if not quiet or not left_ok:
        say(OK if left_ok else NG, "後始末の確認",
            "傷は残っていない" if left_ok else "**訓練が壊したまま戻っていない。手で見ること**")
    results.append(("cleanup", "後始末の確認", left_ok,
                    "傷は残っていない" if left_ok else "壊したまま戻っていない"))
    G.log(f"後始末: {'傷なし' if left_ok else '戻っていない'}")

    # **「走った」と「やり切った」を別の跡にする。**
    #
    # 2026-09-14 実測：鍵が取れないと訓練は**終了コード0・画面は無言・
    # 心拍は更新**で帰る（`もう1つ走っているので、この回は何もしない`）。
    # 心拍を見ている点呼と watchdog からは、**毎日空振りしていても
    # 「検証されている」に見える。**この家がいちばん嫌う形そのもの。
    #
    # 心拍は guardlib が finally で必ず残す（それは正しい——生きている印だから）。
    # だからここでは**項目を最後まで回したときだけ**別の跡を残す。
    # 点呼は pulse を並べて拾うので、置いた瞬間に台帳へ載る
    # （期限は silence-contracts.json に1行。既定は鳴る側）。
    try:
        import json as _json
        from datetime import datetime as _dt
        _p = os.path.join(OPENCLAW, "pulse", "guard-drill-完走.json")
        os.makedirs(os.path.dirname(_p), exist_ok=True)
        with open(_p, "w") as _f:
            _json.dump({"at": _dt.now().isoformat(timespec="seconds")}, _f)
    except OSError:
        pass

    bad = [r for r in results if not r[2]]

    # **同じ落ち方で毎日鳴らさない。**
    # 毎日走らせる以上、直すまで同じ知らせが届き続ける。それは数日で「またか」に変わり、
    # 本物の知らせまで読み飛ばされるようになる。知らせるのは**変わったとき**だけにする。
    # 直ったことは必ず言う（黙って消えると、直ったのか見張りが死んだのか分からない）。
    state = G.load_state()
    was = state.get("failed") or []
    now_failed = sorted(r[0] for r in results if not r[2])
    # **走らせた項目だけで、落ちている一覧を書き換える。**（2026-09-23）
    # 一部の項目だけ手で走らせると、走らせていない項目の「落ちていた」まで消え、
    # 「訓練が通るようになりました（前回は2項目落ちていました）」と知らせていた
    # ——claim と miscopy は走ってもいないのに。走らせなかった項目は前回のまま持ち越す。
    今回走った = {r[0] for r in results}
    持ち越し = sorted(n for n in was
                  if n not in 今回走った and n in {d[0] for d in DRILLS})
    now_failed = sorted(set(now_failed) | set(持ち越し))

    # 今回は実際に走った。見送りの数え上げはここで戻す
    # （戻さないと、いつか通った日の翌日に「3回見送っています」と嘘をつく）。
    state.pop("skips", None)
    state.pop("skip_told", None)

    走った = {r[0] for r in results}
    走らなかった = [t for n, t, _, _ in chosen if n not in 走った]
    if 走らなかった:
        # **走らなかったことを、通ったことの中に混ぜない。**
        # 混ぜると「14項目すべて通りました」が、実際には3項目しか
        # 試していない日にも出る。
        G.log("走らせていない: " + ", ".join(走らなかった))

    if bad:
        print(f"\n  {len(bad)} 項目が落ちました。"
              + (f"家が傷んだのでここで止めました（走らせていない {len(走らなかった)} 項目: "
                 + "、".join(走らなかった) + "）。" if stopped else ""))
        if now_failed != was:
            G.notify("見張りの訓練で問題が見つかりました。\n"
                     + "\n".join(f"・{t}: {d}" for _, t, ok, d in results if not ok)
                     + "\n見張りが黙って壊れている可能性があります。")
            state["failed"] = now_failed
        else:
            G.log("同じ落ち方が続いている（知らせは出さない）")
    else:
        if not quiet:
            print(f"\n  {len(results)} 項目すべて通りました。"
                  + (f"（{len(走らなかった)} 項目は走らせていません）" if 走らなかった else ""))
        if 持ち越し:
            # 走らせた項目は通ったが、走らせていない項目が前回落ちている。**直ったとは言わない。**
            G.log("走らせた項目は通った（落ちたままの %s は今回走らせていない）" % "、".join(持ち越し))
            state["failed"] = now_failed
        else:
            if was:
                G.notify(f"見張りの訓練が通るようになりました（前回は {len(was)} 項目落ちていました）。")
                G.log("訓練が通るようになった")
            state.pop("failed", None)
    G.save_state(state)

    # どんな終わり方でも、いまの状態を最後に見せる（訓練が傷を残していないか）
    #
    # 外のコマンドは画面に直接書くので、先に自分のぶんを出し切っておく。
    # これを忘れると、結果より先に claw status が割り込んで読めなくなる。
    if not quiet:
        print()
        try:
            sys.stdout.flush()
        except BrokenPipeError:
            pass
        try:
            subprocess.run(道具の呼び方([os.path.join(BIN, "claw"), "status"]), check=False)
        except Exception:
            pass

    return 1 if bad else 0


if __name__ == "__main__":
    sys.exit(G.run(main))
