        if 中身 and "--壁なし" not in 中身:
            悪い.append("逃げ道（--壁なし）が無い＝壁ごと捨てられる形")

    # ② 跡（qwc-guard の走りの受領証。モデルは呼ばない）
    sys.path.insert(0, BIN)
    try:
        import guardrun as g
        置き場 = os.path.join(g.記録の根(), "runs", "*", "受領証.json")
    except Exception as e:
        置き場 = None
        悪い.append("guardrun が読めない（%s）" % type(e).__name__)
    新しい = None
    if 置き場:
        for p in sorted(glob.glob(置き場))[-60:]:
            try:
                r = json.load(open(p))
            except Exception:
                continue
            if "qwc-guard-" not in (r.get("作業場") or ""):
                continue
            if time.time() - os.path.getmtime(p) > 48 * 3600:
                continue
            新しい = r
        if 新しい is None:
            悪い.append("48時間のうちに、壁を通った qwc の走りが1件も無い")
        elif "素通し" in (新しい.get("執行") or ""):
            悪い.append("走ってはいるが囲われていない（執行: %s）" % 新しい["執行"])

    # ③ 逃げ道が生きているか（**通るべき側**。塞がっていたら人は壁を捨てる）
    try:
        p = subprocess.run([道, "--壁なし", "--version"], capture_output=True,
                           text=True, timeout=60)
        if p.returncode != 0 or "qwc" not in (p.stdout or ""):
            悪い.append("--壁なし が動かない（%s）"
                        % ((p.stdout or p.stderr or "").strip()[:40]))
    except Exception as e:
        悪い.append("--壁なし を試せない（%s）" % type(e).__name__)

    if 悪い:
        return False, "／".join(悪い)
    執行 = (新しい or {}).get("執行", "?")
    return True, ("qwc は壁を通す作り・逃げ道も生きている"
                  "（直近の走りの執行: %s）" % 執行)


def drill_silent():
    """**黙って終われないことを確かめる。**

    この家のものは落ちずに黙る。いちばん純粋な形は「走ったのに、走った
    という記録だけが無い」で、2026-09-12 に実測したときは
    親を SIGKILL しただけで
      仕事は起きた（作業場にファイルが残る）／受領証は無い／子孫は生き残る
    となり、**そのあと誰にも何も分からなかった。**

    塞ぎ方は、走り出す前に「まだ終わっていない」と書いておくこと。
    無いものは探せないので、**先に在ると約束しておく**しかない。

    ここで見るのは2つ：
      記録  受領証の置き場に、採点される側（壁の中）の手が届かないこと
      黙り  殺された走りが中断として受領証になり、残党も始末されること
    どちらも「通るべき側」つき。掃除が全部を中断と呼ぶように壊れたら、
    **生きている仕事を殺しに行く**ので、そちらも同じ重さで見る。

    最後に**この家の配線**も見る。証明が通っても、5分おきに読む者が
    居なければ黙りは残る（記録だけ増えて誰も読まない、はこの家の実績）。"""
    import guardrun as _g
    ok, msg = _judge(_verify(), [_g.記録, _g.黙り])
    if ok is None:
        return None, msg          # 測っていない。ここから先は足さない
    印 = []
    import schedlib
    登録 = schedlib.PID一覧()
    if "ai.openclaw.guardrun-sweep" not in 登録:
        ok = False
        印.append("掃除が launchd に登録されていない（誰も予告を読まない）")
    心拍 = os.path.expanduser("~/.openclaw/pulse/guardrun-sweep.json")
    if not os.path.exists(心拍):
        ok = False
        印.append("掃除の心拍が無い（一度も走り切っていない）")
    else:
        古さ = time.time() - os.path.getmtime(心拍)
        # **新しさは点呼の担当。**ここは「丸一日以上ない」だけを見る。
        # 重ねて見ると、寝起きの朝に2人が同じことを鳴らす。
        if 古さ > 86400:
            ok = False
            印.append("掃除が %.0f 時間走っていない" % (古さ / 3600))
        else:
            印.append("掃除は %.0f 分前に走った" % (古さ / 60))
    return ok, msg + ("／" + "／".join(印) if 印 else "")


def drill_keep():
    """**守りの設定が消えた形を、「動いた形」として焼き付けないか。**

    2026-09-12 23:10、`config-guard` は `tools.updatePlan` `tools.loopDetection.enabled`
    `agents.defaults.timeoutSeconds` の**3つが消えた設定を「動いた形」として保存した**。
    翌 00:00 に同じ形を再確認し、**05:30 の訓練が落ちるまで7時間**誰も気づかなかった。
    gateway は ok を返し続けていたので、`healthy()` では見えない。

    **「動いた形」は戻る先である。**欠けた形が戻る先になると、
    次にここへ戻すたびに守りが外れる。壊れ方が保存される。

    ここで見るのは3つ。
      対照  いまの実物は通る（何でも断る側に壊れていない）
      壊し  守りを1つずつ欠くと、**それぞれを名指しで**断る
      配線  `cmd_save` が実際にこの判定を通っている（判定があっても、
            呼ばれていなければ効かない——この家で何度も踏んだ形）

    本物の設定は1バイトも触らない。写しを壊して判定に当てるだけ。"""
    import copy
    import importlib.machinery
    import importlib.util
    path = os.path.join(BIN, "config-guard")
    if not os.path.exists(path):
        return False, "config-guard が無い"
    try:
        spec = importlib.util.spec_from_loader(
            "cg_drill", importlib.machinery.SourceFileLoader("cg_drill", path))
        cg = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(cg)
    except Exception as e:                               # noqa: BLE001
        return False, f"config-guard を読み込めない（{type(e).__name__}: {e}）"
    if not hasattr(cg, "守りを確かめる"):
        return False, "config-guard に守りの確認が無い（「動いた形」が素通しで保存される）"

    # 対照。ここが赤いなら、本物の設定のほうが欠けている。
    ok, 欠け = cg.守りを確かめる()
    if not ok:
        return False, "いまの設定に守りが欠けている: " + "／".join(x.split("（")[0] for x in 欠け)

    try:
        with open(os.path.join(OPENCLAW, "openclaw.json")) as f:
            live = json.load(f)
    except (OSError, ValueError) as e:
        return False, f"設定を読めない（{type(e).__name__}）"

    # **戻ってはいけない値。**閾値をここに写さない——写すと2か所が別々にずれる。
    # 置くのは**事故のときに実際に入っていた値**で、これは history の事実なので動かない。
    #
    # これが要る理由は、この訓練自身の壊し試験で分かった（2026-09-13）。
    # 「消したら断るか」だけを見ていると、**期待の側を緩められても通ってしまう**。
    # 実際、予算の上限を 3600 → 999999 に広げたら、訓練は素通しで通った。
    # 消えたときしか試していなかったので、**守りが生きているふりができた。**
    戻ってはいけない値 = {
        "tools.updatePlan": True,                  # 進捗カードが有効だった形
        "tools.loopDetection.enabled": False,      # 本体の検知が切れた形
        "agents.defaults.timeoutSeconds": 172800,  # 48時間＝既定。事故が8時間半まで伸びた
        "tools.deny": [],                          # 写す道具が戻った形（09-09 の23回失敗）
    }

    def _差し替え(道筋, 値=None, 消す=False):
        写し = copy.deepcopy(live)
        親, 枝 = 写し, 道筋.split(".")
        for k in 枝[:-1]:
            親 = 親.setdefault(k, {})
        if 消す:
            親.pop(枝[-1], None)
        else:
            親[枝[-1]] = 値
        return 写し

    # 壊し その1。1つずつ消して、その1つを名指しできるか。
    見つけた = 0
    for 道筋, _期待, _why in cg.守りの設定:
        通った, 訴え = cg.守りを確かめる(_差し替え(道筋, 消す=True))
        if 通った:
            return False, f"{道筋} を消しても通した（守りが1つ抜けても保存される）"
        if not any(x.startswith(道筋) for x in 訴え):
            return False, f"{道筋} を消したのに、別のものを訴えた: {訴え[:1]}"
        見つけた += 1

    # 壊し その2。事故の値そのものを入れて、断るか。
    弾いた = 0
    for 道筋, 値 in 戻ってはいけない値.items():
        if all(道筋 != p for p, _e, _w in cg.守りの設定):
            return False, f"{道筋} が守りの一覧から外されている（事故の値が素通りする）"
        通った, 訴え = cg.守りを確かめる(_差し替え(道筋, 値))
        if 通った:
            return False, (f"{道筋} に {値} を入れても通した"
                           f"（事故のときの形が「動いた形」になる）")
        if not any(x.startswith(道筋) for x in 訴え):
            return False, f"{道筋} に {値} を入れたのに、別のものを訴えた: {訴え[:1]}"
        弾いた += 1

    # 配線。判定を書いただけで呼んでいない、を防ぐ。
    try:
        src = open(path).read()
    except OSError:
        return False, "config-guard を読めない"
    本体 = src.split("def cmd_save", 1)[-1].split("\ndef ", 1)[0]
    if "守りを確かめる" not in 本体:
        return False, "cmd_save が守りの確認を呼んでいない（判定はあるが効かない）"

    return True, (f"守り {見つけた} 件を欠いても、事故の値 {弾いた} 件を入れても"
                  f"名指しで断った（いまの実物は通る・cmd_save から呼ばれている）")


def drill_rewrite():
    """**戻したそばから書き直される、を見抜けるか。**

    2026-09-06 の本物の壊れ方はこれだった。`config-guard --rollback` が
    「動いた形に戻しました」と表示しながら、**ファイルを1バイトも変えていなかった**。
    起動に失敗する gateway が、死ぬ前に設定を自分の形へ書き直すためで、
    **書き込みから約2秒**で起きる。`git checkout` の終了コードは 0 を返すので、
    そこだけ見ていると永久に気づけない。

    **`config` の訓練ではこの形を再現できない。**あちらは壊れた JSON を書くが、
    壊れた JSON は gateway が読めないので、書き直すこともできない。
    だから訓練では戻しが必ず効く。**毎日通っていた訓練は、ここが動く証拠に
    なっていなかった。**（「まだ直っていないこと」に長く残っていた項目。）

    ここでは gateway を使わずに、**上書きする者**を自分で用意して当てる。

        通るべき側    誰も書き直さなければ「残った」と答える
        1回目で捕まる  そもそも書けていない（別の中身）ときに気づく
        2回目で捕まる  **書いた直後は正しく、数秒後に書き直される**
                      ——1回しか読まない実装は、ここだけを必ず見逃す
        配線          cmd_rollback が実際にこの判定を通っている

    本物の設定は触らない。写しの上で、上書きする者を走らせるだけ。"""
    import importlib.machinery
    import importlib.util
    import threading
    path = os.path.join(BIN, "config-guard")
    if not os.path.exists(path):
        return False, "config-guard が無い"
    try:
        spec = importlib.util.spec_from_loader(
            "cg_rw", importlib.machinery.SourceFileLoader("cg_rw", path))
        cg = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(cg)
    except Exception as e:                               # noqa: BLE001
        return False, f"config-guard を読み込めない（{type(e).__name__}: {e}）"
    if not hasattr(cg, "landed"):
        return False, "config-guard に「書けたか」の確認が無い"
    if getattr(cg, "SETTLE", 0) < 4:
        return False, f"待ち時間が {getattr(cg, 'SETTLE', 0)}秒（実測2秒の書き直しを取りこぼす）"

    tmp = tempfile.mkdtemp(prefix="drill-rewrite-")
    元の場所 = cg.CONFIG
    cg.CONFIG = os.path.join(tmp, "openclaw.json")
    正, 誤 = '{"a": 1}\n', '{"a": 2}\n'
    止める = threading.Event()

    def 書き直す(after):
        """gateway の代わり。指定秒後に1回だけ書き直す。"""
        if 止める.wait(after):
            return
        try:
            with open(cg.CONFIG, "w") as f:
                f.write(誤)
        except OSError:
            pass

    try:
        with open(cg.CONFIG, "w") as f:
            f.write(正)
        ok, why = cg.landed(正)
        if not ok:
            return False, f"誰も書き直していないのに「残っていない」と答えた（{why}）"

        with open(cg.CONFIG, "w") as f:
            f.write(誤)
        ok, why = cg.landed(正)
        if ok:
            return False, "別の中身なのに「残った」と答えた（1回目の確認が効いていない）"
        一 = why

        with open(cg.CONFIG, "w") as f:
            f.write(正)
        t = threading.Thread(target=書き直す, args=(1.5,), daemon=True)
        t.start()
        ok, why = cg.landed(正)
        止める.set()
        t.join(timeout=5)
        if ok:
            return False, ("書いた直後は正しく、1.5秒後に書き直されたのに「残った」と答えた"
                           "——1回しか読んでいない（2026-09-06 の壊れ方そのもの）")
        if why == 一:
            return False, f"1回目と2回目を言い分けていない（どちらも「{why}」）"
        二 = why
    finally:
        止める.set()
        cg.CONFIG = 元の場所
        shutil.rmtree(tmp, ignore_errors=True)

    try:
        src = open(path).read()
    except OSError:
        return False, "config-guard を読めない"
    本体 = src.split("def cmd_rollback", 1)[-1].split("\ndef ", 1)[0]
    if "landed(" not in 本体:
        return False, "cmd_rollback が「書けたか」を確かめていない（判定はあるが効かない）"

    return True, (f"書き直されない回は通し、別の中身は「{一}」、"
                  f"{cg.SETTLE}秒のあいだの書き直しは「{二}」と言い分けた"
                  f"（cmd_rollback から呼ばれている）")


def drill_beacon():
    """**外の証人が、居ると言えるか。**

    機械ごと落ちたときは中の誰も気づけない。外に印を置き（`beacon`）、
    外の定時（claude.ai の routine・1時間ごと）がその古さを見る。

    ここで見るのは3つ。**外が生きているかは見ない**——見られるなら、
    それは外の証人ではない。

        出る量   外に出るのは決めた3つ（at・点呼・鳴っている）だけか
        押す口   launchd に登録されていて、押せているか
        正直さ   「外から読めることを見せた記録」が無いときに、
                 点呼が「生きている」と言わないか

    **出る量をここで見るのがいちばん大事。**この家の芯は逃げ道が無いこと
    なので、外に出す量は数えられるほど少なく保つ。項目を足した日にここが落ちる。"""
    b = os.path.join(BIN, "beacon")
    if not os.path.exists(b):
        return False, "beacon が無い（外に押す者が居ない）"

    # ── 出る量。押さずに、出る中身だけ見る ──
    p = run([b, "--dry-run"], timeout=60)
    if not p or p.returncode != 0:
        return False, "beacon --dry-run が動かない"
    try:
        出る = json.loads(p.stdout.strip())
    except ValueError:
        return False, "外に出る中身が JSON として読めない: %s" % p.stdout[:80]
    決めた = {"at", "点呼", "鳴っている"}
    余計, 欠け = set(出る) - 決めた, 決めた - set(出る)
    if 余計:
        return False, ("決めていないものが外に出ている: %s"
                       "（外に出す量は数えられるほど少なく保つ）" % sorted(余計))
    if 欠け:
        return False, "外に出るはずのものが欠けている: %s" % sorted(欠け)

    # ── 押す口 ──
    import schedlib
    if "ai.openclaw.beacon" not in schedlib.PID一覧():
        return False, "beacon が定時に登録されていない（誰も押さない）"
    if not os.path.exists(os.path.join(PULSE_DIR, "beacon.json")):
        return False, "beacon が一度も走り切っていない"

    # ── 正直さ。点呼の判定だけを、写しの入力に当てる ──
    sys.path.insert(0, BIN)
    try:
        import silence
    except Exception as e:                               # noqa: BLE001
        return False, "点呼が読めない（%s）" % type(e).__name__
    いま = time.time()
    普通 = silence._外の証人(いま, lambda n: いま - 60, 押せた=いま - 60)
    止まり = silence._外の証人(いま, lambda n: いま - 60, 押せた=いま - 86400)
    未証明 = silence._外の証人(いま, lambda n: いま - 60, 押せた=いま - 60, 確かめた="")
    古い = silence._外の証人(いま, lambda n: いま - 60, 押せた=いま - 60,
                            確かめた="2020-01-01")
    押せていない = silence._外の証人(いま, lambda n: いま - 60, 押せた=0)
    if 古い["判定"] == silence.生:
        return False, "外から読めることを見せたのが6年前なのに「生きている」と読んだ"
    # **心拍が新しくても、押せていなければ黙り。**
    # 2026-09-14、外の印が1時間39分止まっているのに「押せている」と言った。
    # 心拍は Guard.run が必ず書くので、**押せなくても新しくなる**。
    # しかも beacon --show で確かめるたびに心拍が更新され、確かめる行為が古さを隠した。
    if 押せていない["判定"] != silence.黙:
        return False, ("一度も押せていないのに「%s」と読んだ"
                       "（心拍を結果として読んでいる）" % 押せていない["判定"])
    if 止まり["判定"] != silence.黙:
        return False, ("心拍は新しいが1日押せていないのに「%s」と読んだ"
                       % 止まり["判定"])
    if 普通["判定"] != silence.生:
        return False, "押せていて記録もあるのに「%s」と読んだ" % 普通["判定"]
    if 未証明["判定"] == silence.生:
        return False, ("外から読めることを見せていないのに「生きている」と読んだ"
                       "（証明していない壁を、有ることにしている）")
    return True, ("外に出るのは決めた3つだけ・launchd から押せている・"
                  "見せた記録が無ければ「%s」と言う" % 未証明["判定"])


def drill_heal():
    """**直す者が、人の手を消さないか。**

    2026-09-13、`self-heal` が人の作業を3つ消した。直す前に作業ツリーごと
