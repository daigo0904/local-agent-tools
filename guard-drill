def _事故時点の写しへ向ける(hb):
    """house-brief が読む記録と時計を、事故の時点で切り出した写しへ向ける。駄目なら理由を返す。

    **本番の記録ではなく、事故の時点の写しに当てる。**（2026-09-23）
    本番の記録は毎日書き足される。9/15 01:04 に同じ会話へ失敗した exec が2件足され、
    検出器は正しく 8 回と数えたのに、claim は「6 回のはず」で8日間毎朝落ちていた。
    窓（claim 30日・miscopy 10日）も、日が経てば事故そのものを窓の外へ押し出す
    （miscopy はこれで 9/20 から毎回落ちていた）。
    写しは読み取り専用で、指紋が変わったら使わない（黙って別物に当てないため）。"""
    import hashlib
    try:
        with open(CLAIM_FIXTURE, "rb") as f:
            指紋 = hashlib.sha256(f.read()).hexdigest()
    except OSError as e:
        return "事故時点の記録の写しが無い（%s）: %s" % (type(e).__name__, CLAIM_FIXTURE)
    if 指紋 != CLAIM_FIXTURE_SHA256:
        return "事故時点の記録の写しが変わっている（指紋 %s…）" % 指紋[:12]

    class 写しの時刻(hb.datetime):
        @classmethod
        def now(cls, tz=None):
            return CLAIM_FIXTURE_AT
    hb.AGENT_DB = CLAIM_FIXTURE
    hb.datetime = 写しの時刻
    return None


