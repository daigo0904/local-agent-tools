def drill_escape():
    """壁から抜け出せないことを確かめる。**抜け出せたら壁ではない。**

    中身は guardrun.verify() に置いてある。**同じことを2か所に書かない。**
    ここで別に書くと、片方だけ直った日に、訓練のほうが古い壁を見る。"""
    import guardrun as _g  # noqa: F401  （読めるかはここで落ちる）
    return _judge(_verify(), [_g.場所, _g.秘密, _g.通信])


def drill_limits():
    """量・CPU・時間の上限が効くことを確かめる。**孫まで始末できるかも見る。**

    **「残党」は既定で求めない。**自分でプロセスグループを作って親が即死する
    孫は、sandbox-exec では塞げない（2026-09-11 実測。killpg は届かず、
    親が即死するので子孫としても辿れない。環境変数の印で探す案も、
    ps が子の環境を見せないので没になった）。塞ぐには専用ユーザが要る。

    **落とさないが、黙らない。**毎日落ちる訓練は読まれなくなるので合否には
    入れないが、状態は毎回そのまま出す。塞がった日に気づけるように。"""
    import guardrun as _g
    ok, msg = _judge(_verify(), [_g.量, _g.総量, _g.CPU, _g.時間])
    if ok is None:
        return None, msg          # 測っていない。ここから先は足さない
    res, _ = _verify()
    if res and _g.残党 in res:
        直った, 説明 = res[_g.残党]
        msg += "／残党: %s（%s）" % ("塞がった" if 直った else "未証明", 説明)
    return ok, msg


def drill_spin():
    """**空回りの見分けが、まだ効くか。**

    2026-09-11 の8時間25分は、Discord から来た1件の依頼が
    progress_card を139回呼び続けただけで終わった。あれは
    2分おきに道具を呼んでいたので、**この家の見張り全員から忙しく見えていた**。

    loop-guard はその形を「時間 かつ 回数」で見分ける。しきい値は記録162件に
    当てて、事故1件だけが残ることを確かめて決めた値なので、
    **しきい値をいじれば黙るし、記録が消えれば試せなくなる。**

    ここでやるのは回帰試験。本物の記録に当てて
      1) 事故の依頼を拾えるか
      2) 健全な161件を拾わないか
    の両方を見る。**片方だけだと、何でも拾う見張りでも通ってしまう。**

    模擬の故障を作らないので、この訓練は何も壊さない。"""
    # **事故は1件ではない。**loop-guard に「返りを見ない門」が入った 2026-09-13、
    # 2件目が掘り当たった。数を決め打ちにしていたので、訓練のほうが古くなった。
    #
    #   7e2888e5  2026-09-11 の8時間25分（progress_card 139回）
    #   3aab972c  同じころの LINE の事故（conversations_send を引数ごと21回続けて。
    #             37文字の識別子を写し損ねて26回中23回失敗したあの回）
    #
    # **数ではなく、名指しした事故が全部拾えるかで見る。**そのうえで
    # 「何でも拾う」側に壊れていないかを、**上限**で見る（記録の 5% まで）。
    # 数を決め打ちにすると、新しい事故を掘り当てた日に訓練のほうが落ちる。
    # **どの門が支えているかまで書く。**名前だけだと、別の門が緩んで
    # 代わりに拾っているのを「効いている」と読む。2026-09-13 に実測で確かめた:
    # 返りを見ない門を殺し、時間の門を 3分・12回 に緩めると、
    # **2件とも拾えたまま、返りを見ない門は死んでいる。**
    #
    #   7e2888e5  8時間25分（progress_card 139回・2026-09-11）        時間の門
    #   3aab972c  宛先の識別子を5文字落として、同じ引数で21回続けた
    #             conv_…32f8e4de（37文字）→ conv_…3e4（32文字）
    #             **呼び出しは23回・全部 conversations_send・全部 09-09**
    #             （22回が 20:59:54〜21:01:58 の約2分に集中し、1回だけ 21:15:52。
    #              最後の1回は**別の依頼**〈seq 843・道具2回・連続1〉なので、
    #              **鳴らないのが正しい**。事故全体は16分でも、空回りとして
    #              捕まえるべきなのは seq 788 の4分のほう。
    #              **「事故の長さ」と「空回りの単位」は別物。**）
    #                                                                 返りを見ない門
    #
    # **「文字列を含む行」を数えない。**最初は 09-09〜09-12 と書いていたが、
    # それは要約や履歴に識別子が residual で残っている行（67件）の範囲で、
    # **実際の呼び出し（23件）は 09-09 の中だけ**だった。
    # 道具を呼んだ跡（tool_use）と、文字が写っているだけの行は別物。
    #
    # **覚え書きの「2026-09-11 LINE の message failed」とは別口。**
    # あちらは `message` 道具（15回・09-08〜09-11）で、こちらは
    # `conversations_send`（23回・09-09）。根は同じ（長い識別子を写せない）だが、
    # 道具も日付も違う。1文に畳むと、記録から探せなくなる。
    事故たち = {"7e2888e5": ("8時間25分（progress_card 139回）",
                             "SPIN_MINUTES", "時間の門"),
                "3aab972c": ("宛先の識別子を5文字落として同じ引数を21回続けた"
                             "（conversations_send 23回・09-09）",
                             "SAME_ARGS_STREAK", "返りを見ない門")}
    INCIDENT = "7e2888e5"
    tool = os.path.join(BIN, "loop-guard")
    if not os.path.exists(tool):
        return False, "loop-guard が無い（空回りを見る者が居ない）"
    try:
        p = subprocess.run([tool, "--replay"], capture_output=True,
                           text=True, timeout=180, stdin=subprocess.DEVNULL)
    except Exception as e:
        return False, f"loop-guard を呼べなかった（{type(e).__name__}）"
    out = p.stdout.strip()
    m = re.search(r"当てた依頼\s*(\d+)\s*件.*?引っかかった\s*(\d+)\s*件", out, re.S)
    if not m:
        return False, f"判定の結果が読めない: {out[:160]}"
    total, fired = int(m.group(1)), int(m.group(2))
    if total < 50:
        # 記録が消えると、この訓練は「通った」ではなく「試せなくなった」。
        # **黙って通すと、試験そのものが消えたことに気づけない。**
        return False, (f"当てられた依頼が {total} 件しかない。"
                       f"記録が消えたので、この試験はもう証拠になっていない")
    if fired == 0:
        return False, (f"{total} 件に当てて1件も拾わなかった。"
                       f"事故（{INCIDENT}）を見分けられなくなっている")
    抜け = [f"{k}（{v[0]}）" for k, v in 事故たち.items() if k not in out]
    if 抜け:
        return False, (f"{fired} 件拾ったが、名指しした事故が入っていない: "
                       + "／".join(抜け))
    上限 = max(2, total // 20)
    if fired > 上限:
        return False, (f"{total} 件のうち {fired} 件を拾った（上限 {上限}）。"
                       f"何でも拾う側に壊れている疑い")

    # **見分けるだけでは足りない。空回りできない形に保たれているかも見る。**
    #
    # 事故の燃料は progress_card だった。always 成功して、返りが毎回
    # 新しい（rev N+1）ので、**本体の空回り検知にも「進んでいる」と見える**。
    # 139回呼んで返りは139種類。同一の返りの連続は最長1回で、
    # 本体のしきい値10には原理的に届かない。だから道具ごと外してある。
    # ここが戻されたら、見分けられても同じことがまた起きる。
    want = {
        "tools.updatePlan": ("false", "進捗カード（空回りの燃料）が戻っている"),
        "tools.loopDetection.enabled": ("true", "本体の空回り検知が切れている"),
    }
    for path, (expect, complaint) in want.items():
        r = run([CLAW_BIN, "config", "get", path], timeout=60)
        got = (r.stdout.strip().splitlines()[-1].strip().lower()
               if r and r.stdout.strip() else "")
        if got != expect:
            return False, f"{complaint}（{path} が {got or '未設定'}）"
    r = run([CLAW_BIN, "config", "get", "agents.defaults.timeoutSeconds"], timeout=60)
    try:
        budget = int(r.stdout.strip().splitlines()[-1])
    except (AttributeError, ValueError, IndexError):
        return False, "実行予算が読めない（既定の48時間に戻っている疑い）"
    if not 0 < budget <= 3600:
        return False, (f"実行予算が {budget}秒。48時間の既定に戻ったか、"
                       f"1時間より長い。8時間半の事故はこれが無かったから伸びた")

    # **その門を殺したら、その事故が消えるか。**
    # 拾えたことは「何かが拾った」までしか言わない。門ごとに殺して確かめる。
    src = open(tool).read()
    支えた = []
    for 事故, (説明, 定数, 門名) in 事故たち.items():
        if f"\n{定数} = " not in src:
            return False, f"{門名}の閾値（{定数}）が loop-guard に見つからない（名前が変わった？）"
        壊し = re.sub(rf"^{定数} = .*$", f"{定数} = 99999", src, count=1, flags=re.M)
        d = tempfile.mkdtemp(prefix="drill-spin-")
        try:
            写し = os.path.join(d, "loop-guard-nogate")
            with open(写し, "w") as f:
                f.write(壊し)
            os.chmod(写し, 0o755)
            env = dict(os.environ, PYTHONPATH=BIN)   # 写しの隣に guardlib は無い
            q = subprocess.run([sys.executable, 写し, "--replay"], capture_output=True,
                               text=True, timeout=180, stdin=subprocess.DEVNULL, env=env)
        except Exception as e:                       # noqa: BLE001
            return False, f"{門名}を殺した写しを走らせられない（{type(e).__name__}）"
        finally:
            shutil.rmtree(d, ignore_errors=True)
        # **落ちたのを「事故が消えた」と読まない。**写しが動いたことを先に確かめる。
        if q.returncode not in (0, 1) or "当てた依頼" not in q.stdout:
            return False, (f"{門名}を殺した写しが走らなかった（exit {q.returncode}）。"
                           f"消えたのではなく、試せていない: "
                           f"{(q.stderr or q.stdout).strip().splitlines()[-1][:80] if (q.stderr or q.stdout).strip() else ''}")
        if 事故 in q.stdout:
            return False, (f"{門名}を殺しても {事故} を拾った。"
                           f"別の門が代わりに拾っている＝この門が効いている証拠にならない")
        支えた.append(門名)

    # ── 記録に無い形は、合成例で見る ──
    # **返りを見ない門でしか捕まらない形は、いまの記録に1件も無い。**
    # memory_search がその形（debug の処理時間で返りが毎回変わる）だが、
    # 記録には3回しか呼ばれた跡が無く、繰り返した例が無い。
    # なので loop-guard の `--selftest`（その場で作った例に当てる）も通す。
    # **記録が無いことを、試さない理由にしない。**
    p2 = run([tool, "--selftest"], timeout=120)
    if not p2 or p2.returncode != 0:
        return False, ("合成例の自己試験が通らない: "
                       + ((p2.stdout or p2.stderr).strip().splitlines()[-1][:90]
                          if p2 else "走らなかった"))
    m2 = re.search(r"合計:\s*(\d+)\s*件成功\s*/\s*(\d+)\s*件失敗", p2.stdout or "")
    if not m2:
        return False, "自己試験の結果が読めない（出力の形が変わった？）"
    成功, 失敗 = int(m2.group(1)), int(m2.group(2))
    if 失敗 or 成功 < 5:
        return False, f"自己試験が {成功} 件成功 / {失敗} 件失敗"

    return True, (f"合成例 {成功} 件・"
                  f"記録 {total} 件に当てて事故 {len(事故たち)} 件を拾い"
                  f"（{fired} 件・上限 {上限}）、"
                  f"{'／'.join(支えた)}を殺すとそれぞれ消え、"
                  f"燃料も断ってある（進捗カード無効・検知有効・予算{budget // 60}分）")


def drill_silence():
    """**黙って消えることが、まだ見えるか。**

    ここが見えなくなっても、**誰も教えてくれない**（見えないのだから）。
    だから毎日、使い捨ての launchd の仕事を本物の OS に登録して、
    実際に走らせ・失敗させ・黙らせて、点呼がそれを名指しできるかを見る。

    中身は silence.verify() に置いてある。**同じことを2か所に書かない。**

    **「全部通った」は「全部を通すように壊れた」と見分けがつかない**ので、
    verify() の中に「通るべき側」（健全な回を健全と読む）が入れてある。
    そのうえでここでは、**本物の家に当てて全部が鳴っていないこと**も見る。
    何でも鳴る見張りは、何も見ていない見張りと同じだけ役に立たない。"""
    sys.path.insert(0, BIN)
    try:
        import silence
    except Exception as e:
        return False, "点呼が読めない: %s" % e
    try:
        res = silence.verify()
    except Exception as e:
        return False, "証明が走らない: %s: %s" % (type(e).__name__, e)
    bad = ["%s（%s）" % (k, why) for k, (ok, why) in res.items() if not ok]
    if bad:
        return False, "／".join(bad)

    # **本物の家に当てる。**覚えは読むだけで書かない（watchdog の時計を進めない）。
    try:
        所見, _ = silence.点呼()
    except Exception as e:
        return False, "本物に当てられない: %s" % type(e).__name__
    鳴 = [x for x in 所見 if x["判定"] in silence.鳴る判定 and x["鍵"] != "外の証人"]
    if len(所見) < 10:
        return False, ("台帳に %d 本しか出ていない。launchd から生えていないか、"
                       "読めていない" % len(所見))
    if len(鳴) > len(所見) // 2:
        return False, ("%d 本中 %d 本が鳴っている。家が燃えているか、"
                       "点呼が何でも鳴る側に壊れている" % (len(所見), len(鳴)))
    return True, ("%d 項目すべて通り、本物の %d 本に当てて %d 本だけ鳴った"
                  % (len(res), len(所見), len(鳴)))


