    return True, f"{int(took)}秒で気づいて手を出した"


def _watchdogの値(名, 既定):
    """watchdog のしきい値を、**あちらのソースから読む。**

    こちらに数字を書き写すと、あちらを変えた日から訓練が嘘をつく。
    2026-09-12、まさにそれで落ちた：訓練は watchdog を**2回**突いて
    「入れ直した」を待っていたが、watchdog は**6回**続けて黙って初めて
    入れ直す（`SILENT_BEFORE_RESTART = rounds(6)`）。**永久に通らない訓練**
    だったが、`--full` を誰も走らせていなかったので13日間気づかなかった
    （訓練ログ 08-30 以降、重い項目の記録は今日の2件だけ）。"""
    import importlib.util
    try:
        s = importlib.util.spec_from_loader(
            "watchdog_定数",
            importlib.machinery.SourceFileLoader("watchdog_定数",
                                                 os.path.join(BIN, "watchdog")))
        m = importlib.util.module_from_spec(s)
        s.loader.exec_module(m)
        return getattr(m, 名, 既定)
    except Exception:
        return 既定


def drill_gateway():
    """受け口を黙らせて、watchdog が入れ直すか。**LINE と Discord が数秒切れる。**"""
    pids = run(["lsof", "-nP", "-iTCP:18789", "-sTCP:LISTEN", "-t"])
    pid = pids.stdout.split()[0] if pids and pids.stdout.strip() else None
    if not pid:
        return False, "gateway が見つからない"

    state = os.path.join(OPENCLAW, "watchdog-state.json")
    saved = open(state).read() if os.path.exists(state) else None
    if os.path.exists(state):
        os.remove(state)

    mark = log_lines("watchdog")
    os.kill(int(pid), signal.SIGSTOP)          # 立っているのに答えない状態
    try:
        t0 = time.time()
        # **気づくところまで**は、記録が伸びれば分かる。
        poke_until_noticed("watchdog", mark, [os.path.join(BIN, "watchdog")], 180)
        # **手当てまで見届ける。**watchdog は「連続で何回黙ったか」で動くので、
        # その回数ぶん突く。回数はあちらのソースから読む（写すとずれる）。
        必要 = _watchdogの値("SILENT_BEFORE_RESTART", 6)
        poke_until_line("watchdog", mark, [os.path.join(BIN, "watchdog")],
                        "入れ直", 必要 * 40 + 120)
        took = time.time() - t0
    finally:
        resume(pid)
        if saved is not None:
            with open(state, "w") as f:
                f.write(saved)

    # **ポートの開閉では判定しない。**止めたプロセスもポートは握ったままなので、
    # 必ず「開いている」と出る。見た側が「開いているのに答えない」を扱う一式で、
    # 訓練だけがポートを信じていた。
    if not wait_until(healthy, 180, 5):
        return False, "訓練のあと受け口が戻らない。手で見ること"
    saw, detail = noticed("watchdog", mark, ["gateway が"])
    if not saw:
        return False, detail
    fixed, _ = noticed("watchdog", mark, ["入れ直して戻った", "入れ直した"])
    if not fixed:
        return False, f"気づいたが入れ直していない（{detail}）"
    return True, f"{int(took)}秒で気づいて入れ直した"


def drill_config():
    """設定を壊して、動いた形に戻せるか。**受け口が一時的に止まる。**

    入れ直しても戻らないときの最後の決定論的な手当て。
    ここが効かないと、設定を触った瞬間に戻れなくなる。"""
    cg = os.path.join(BIN, "config-guard")
    conf = os.path.join(OPENCLAW, "openclaw.json")
    if not os.path.exists(cg):
        return False, "config-guard が無い"
    if subprocess.run(道具の呼び方([cg]), capture_output=True, text=True).stdout.count("まだ無い"):
        return False, "「動いた形」がまだ記録されていない"

    # **watchdog の「入れ直した直後」を消してから始める。**
    # 2026-09-12、`--full` で gateway の訓練の直後に走ったら、あちらの
    # 入れ直しで 900秒のクールダウンに入っており、**誰も直せない時間帯に
    # 設定を壊した**（watchdog のログ「入れ直した直後なので待つ」）。
    # 訓練は「手当てが効くか」を見るものなので、手当てが構造的に
    # 動けない状態から始めてはいけない。gateway の訓練と同じ作法で
    # 覚えを預かって、終わったら戻す。
    state = os.path.join(OPENCLAW, "watchdog-state.json")
    saved = open(state).read() if os.path.exists(state) else None
    if os.path.exists(state):
        os.remove(state)

    mark = log_lines("watchdog")
    with open(conf, "a") as f:
        f.write("\nこれは訓練で壊した行\n")
    import schedlib
    schedlib.蹴る("ai.openclaw.gateway", 殺す=True)
    try:
        # 壊れた設定で本当に落ちるまで待つ。落ちる前に見張りを呼んでも意味がない。
        if not wait_until(lambda: not port_open(GATEWAY_PORT), 60, 2):
            return False, "設定を壊しても受け口が落ちない（訓練にならない）"
        # 見張りは連続3回で手を出す。その結末が記録に出るまで待つ。
        # **待つ長さも、あちらの数字から出す。**420秒の決め打ちでは
        # 9ラウンド分（各ラウンドは health の時間切れ最大30秒）に足りず、
        # 2026-09-13 は watchdog が手当てに入る**24秒前に**訓練が諦めていた。
        # 「落ちた」の理由が、直っていないのか待ち足りないのか区別できなくなる。
        回数 = _watchdogの値("DOWN_BEFORE_RESTART", 9)
        一回 = _watchdogの値("HEALTH_TIMEOUT", 30)
        poke_until_line("watchdog", mark, [os.path.join(BIN, "watchdog")],
                        "設定を動いた形に戻して復旧した",
                        (回数 + 2) * (一回 + 5) + 120)
    finally:
        # 見張りが戻せなかった場合に備えて、こちらでも必ず戻す。
        # **いまの config-guard の作法で呼ぶこと。**`--rollback` だけでは
        # 「ゲートウェイが登録されたままです。戻しませんでした」で**拒否される**
        # （2026-09-06 に足した正しい振る舞い）。訓練の後始末だけがその前の
        # 呼び方のまま残っていて、2026-09-12 に**家を10分落とした**。
        # 拒否が正しいのだから、合わせるのはこちら側。
        subprocess.run(道具の呼び方([cg, "--rollback", "--stop-gateway", "--quiet"]),
                       capture_output=True, timeout=120)
        # `--stop-gateway` は登録ごと外すので kickstart では起きない。
        # 登録して起こすのは claw の仕事。
        subprocess.run(道具の呼び方([os.path.join(BIN, "claw")]), capture_output=True,
                       timeout=180)
        if saved is not None:
            with open(state, "w") as f:
                f.write(saved)

    if not wait_until(healthy, 180, 5):
        return False, "訓練のあと受け口が戻らない。手で見ること"
    # 壊れた設定が捨てられていないか（原因を追えなくなるのが一番困る）
    log = subprocess.run(道具の呼び方([cg, "--log"]),
                         capture_output=True, text=True).stdout
    if "戻す前の形" not in log:
        return False, "戻したが、壊れた設定を残していない"
    saw, detail = noticed("watchdog", mark, ["設定を動いた形に戻して復旧した"])
    if not saw:
        return False, "見張りが設定を戻した形跡がない"
    return True, "設定を戻して復旧し、壊れた形も残した"


def drill_thrash():
    """積み直しの取り合いに、model-guard が気づくか。

    本物のログも本物の ollama も触らない。**偽のログを作って読ませるだけ。**
    2026-08-31 の朝、モデルは25分で25回積み直され、qwc はその巻き添えで
    1手も終われなかった。それでも見張りは最後まで「正常」と書いていた。
    ここが効かないと、同じ朝がもう一度来ても、また誰も気づかない。

    3つ見る。①広さが行き来しているのを見つけるか ②同じ広さなら
    「枠の取り合い」と言い分けるか ③静かなときに騒がないか。"""
    tmp = tempfile.mkdtemp(prefix="drill-thrash-")
    try:
        def fake_log(name, widths, minutes):
            path = os.path.join(tmp, name)
            with open(path, "w") as f:
                for i, m in enumerate(minutes):
                    when = (datetime.now().astimezone() - timedelta(minutes=m))
                    f.write(f'time={when.isoformat(timespec="milliseconds")} level=INFO '
                            f'msg="starting llama-server" '
                            f'cmd="llama-server --model /x -c {widths[i % len(widths)]} -np 1"\n')
            return path

        def ask(path):
            env = {**os.environ, "OLLAMA_LOG": path}
            r = subprocess.run(道具の呼び方([os.path.join(BIN, "model-guard"), "--report", "--dry-run"]),
                               capture_output=True, text=True, timeout=120, env=env)
            for line in r.stdout.splitlines():
                if line.startswith("積み直し"):
                    return line
            return ""

        fight = ask(fake_log("fight.log", [32768, 65536], [1, 2, 3, 4, 5, 6]))
        if "違う広さ" not in fight:
            return False, f"広さの取り合いを見逃した（{fight or '何も言わない'}）"

        crowd = ask(fake_log("crowd.log", [65536], [1, 2, 3, 4, 5]))
        if "枠を取り合" not in crowd:
            return False, f"枠の取り合いと言い分けられない（{crowd or '何も言わない'}）"

        quiet = ask(fake_log("quiet.log", [65536], [1, 400]))
        if "落ち着いている" not in quiet:
            return False, f"静かなのに騒いだ（{quiet}）"

        return True, "取り合いを見つけ、種類を言い分け、静かなときは黙る"
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def drill_busy():
    """「働いているか」の見分けが裏返っていないか。

    2026-08-31 に実測して分かったこと:

        待機      CPU  0%     ログ 伸びない
        前処理中  CPU  0〜1%  ログ **仕事の跡が書かれる**
        生成中    CPU  6〜7%  ログ 断続的に書かれる
        固まり    CPU  約4%   ログ **何も書かれない**

    前処理は GPU の仕事なので CPU からは見えない。**CPU だけで見ると、
    守るべき前処理を「暇」と読み、殺すべき固まりを「働いている」と読む**
    ——ちょうど裏返る。実際その日、ollama が無応答になったのに見張りは
    10分間「処理中だから見送り」と書き続けた。

    さらに、ログが伸びたかを素朴に見ると、**見張り自身の `/api/tags` の
    1行**を仕事と誤読して、また固まりを見逃す。だから `[GIN]` 行は数えない。

    ここでは本物の ollama を触らない。**偽のログを読ませて**、
    ①何も書かれなければ IDLE ②仕事の行が書かれれば BUSY
    ③HTTPの記録だけなら IDLE（見逃しの原因になった罠）を確かめる。"""
    # **モデルを動かしている側（llama-server）が居なければ、見分けは試せない。**
    # model-guard の runner_busy() は居ないと即「暇」を返すので、偽の記録を読ませても
    # IDLE になり、「動いている仕事を殺す側に倒れている」と**誤って告発していた**。
    # 家ではモデルが常に載っているので表に出ない（2026-09-23、家の無い Mac で出た）。
    居る = run(["pgrep", "-f", "llama-server"])
    if not (居る and (居る.stdout or "").strip()):
        return None, "モデルが載っていない（llama-server が居ない）ので、見分けを試せない"
    tmp = tempfile.mkdtemp(prefix="drill-busy-")
    try:
        log = os.path.join(tmp, "ollama.log")

        def ask(write_after=None):
            open(log, "w").close()
            if write_after is not None:
                def later():
                    time.sleep(0.5)
                    with open(log, "a") as f:
                        f.write(write_after + "\n")
                threading.Thread(target=later, daemon=True).start()
            env = {**os.environ, "OLLAMA_LOG": log}
            r = subprocess.run(道具の呼び方([os.path.join(BIN, "model-guard"), "--busy"]),
                               capture_output=True, text=True, timeout=120, env=env)
            return r.stdout.strip()

        # 本物のモデルが誰かに使われていると CPU 側が反応してしまう。
        # そのときは見分けを確かめようがないので、正直に見送る。
        for _ in range(3):
            base = ask()
            if base == "IDLE":
                break
            time.sleep(3)
        else:
            # **見送ったのを「通った」に数えない。**（2026-09-23）
            # True を返していたので、使用中の日は毎回「通った」と記録され、試していない日と区別がつかなかった。
            return None, "モデルが使用中だったので見分けを試せない（見送った）"

        worked = ask("slot print_timing: id  0 | task 7 | prompt processing, n_tokens = 512")
        if worked != "BUSY":
            return False, f"前処理中を見分けられない（{worked}）＝動いている仕事を殺す側に倒れている"

        gin = ask('[GIN] 2026/08/31 - 05:30:00 | 200 | 1.5ms | 127.0.0.1 | GET "/api/tags"')
        if gin != "IDLE":
