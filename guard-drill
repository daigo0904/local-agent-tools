_証明の覚え = None


# **「測っていない」は、通ったでも落ちたでもない третье。**
# 訓練の返りは (ok, 説明) の2つ組なので、ok に None を返して言い分ける。
# 走らなかった項目と同じ扱いにする——**通った数に混ぜない。**
測れなかった = object()


def _verify():
    """guardrun の証明を1回走らせる。{壁: (効いたか, 説明)} か、読めなければ None。

    **1回の訓練では1度しか走らせない。**証明は実測25秒で、中で本物の
    sandbox-exec を何十回も起こす。項目ごとに呼び直していたころは
    同じことを3回やっていた（escape 1回・limits 2回）。
    覚えるのはプロセスの中だけなので、次の訓練では必ず走り直す。"""
    global _証明の覚え
    if _証明の覚え is not None:
        return _証明の覚え
    sys.path.insert(0, BIN)
    try:
        import guardrun
    except Exception as e:
        _証明の覚え = (None, "guardrun が読めない: %s" % e)
        return _証明の覚え
    try:
        _証明の覚え = (guardrun.verify(), None)
    except getattr(guardrun, "証明が取れない", ()) as e:
        # **先客が居て測れなかった。落ちたとは書かない。**
        # 2026-09-13、証明は同時に2つ走ると壁を「無い」と報告していた
        # （作業場を共有していたため。単独 11○0★ ／ 同時は両方 ★）。
        # 直したのは向こう（走りごとに mkdtemp ＋ 鍵・最大600秒待つ）。
        # 待っても取れなければ、この例外が来る。
        #
        # **ここで ★ に倒すと、直した意味が消える。**衝突を「壁が無い」と
        # 書くと、`require` に挙げた壁が証明できない扱いになって本物の仕事が止まる。
        # だから「測っていない」として持ち帰る（通ったとも落ちたとも書かない）。
        _証明の覚え = (測れなかった, "証明の鍵が取れなかった: %s" % e)
    except Exception as e:
        _証明の覚え = (None, "証明が走らない: %s" % e)
    return _証明の覚え


def _judge(壁たち, names):
    """名指しした壁だけを見る。**説明はそのまま持ち帰る。**"""
    res, why = 壁たち
    if res is 測れなかった:
        return None, why          # 測っていない。落ちたとは書かない
    if res is None:
        return False, why
    bad = ["%s: %s" % (n, res[n][1]) for n in names if not res.get(n, (False, "見ていない"))[0]]
    if bad:
        return False, "／".join(bad)
    return True, "／".join("%s（%s）" % (n, res[n][1]) for n in names)


