#!/usr/bin/env python3
# guardrun の --期待（コマンドから期待を宣言する口）の試験。対照: bea15d9 では 1/6、足した版で 6/6（2026-09-27）。
import json,os,subprocess,sys,tempfile
G=sys.argv[1] if len(sys.argv)>1 else os.path.expanduser('~/bin/guardrun.py')
def wd():
    d=tempfile.mkdtemp(prefix='期待の試験-',dir='/Users/Shared'); os.chmod(d,0o777); return d
def run(exp,cmd,expfile_in_wd=False):
    d=wd(); args=[sys.executable,G]
    if exp is not None:
        f=os.path.join(d,'期待.json') if expfile_in_wd else tempfile.mktemp(suffix='.json')
        open(f,'w').write(json.dumps(exp,ensure_ascii=False)); args+=['--期待',f]
    p=subprocess.run(args+[d,'/bin/sh','-c',cmd],capture_output=True,text=True)
    try:
        r=json.loads(p.stdout); rp=r['受領証']
        rp=rp if rp.endswith('.json') else os.path.join(rp,'受領証.json')
        full=json.load(open(rp)); r.update({k:full[k] for k in ('期待','事後')})
    except Exception as ex: r=None
    return p.returncode,r,p.stderr[-300:]
ok=0;n=0
def check(name,cond,detail):
    global ok,n; n+=1; ok+=bool(cond); print(('○' if cond else '★'),name,detail)
c,r,e=run(None,'echo hi > a.txt'); check('対照: 宣言なし→未宣言', c==0 and r and r['事後']['照合']['結果']=='未宣言', (c, r and r['事後']['照合'], r and r['判定']))
c,r,e=run({"判定":"緑","終了コード":0,"差分":{"追加":["a.txt"]}},'echo hi > a.txt'); check('一致', c==0 and r and r['事後']['照合']['結果']=='一致' and len(r['事後']['照合']['見た項目'])==3, (c, r and r['事後']['照合'], r and r['期待'].get('宣言者')))
c,r,e=run({"判定":"青"},'echo hi > a.txt'); check('不一致（終了コードは変えない）', c==0 and r and r['事後']['照合']['結果']=='不一致', (c, r and r['事後']['照合']))
c,r,e=run({"判定x":"緑"},'echo hi > a.txt'); check('知らない欄は断る', c==2 and r is None and '知らない欄' in e, (c,e.strip()[-80:]))
c,r,e=run({"判定":"成功"},'echo hi > a.txt'); check('知らない判定は断る', c==2 and r is None, (c,e.strip()[-80:]))
c,r,e=run({"判定":"青"},'echo hi > a.txt; printf %s \'{"判定":"緑"}\' > 期待.json',expfile_in_wd=True); check('中から書き換えても宣言は動かない', r and r['期待']['結果']=={"判定":"青"} and r['事後']['照合']['結果']=='不一致', (c, r and r['期待'].get('結果'), r and r['事後']['照合']['結果']))
print(f'{ok}/{n}')
