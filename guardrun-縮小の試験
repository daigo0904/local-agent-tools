#!/usr/bin/env python3
"""縮小の警告基準を実ファイルの前後差分で検査する。推論・本物の受領証は使わない。"""
import importlib.util
import json
from pathlib import Path
import sys
import tempfile

source = Path(sys.argv[1]) if len(sys.argv) > 1 else Path(__file__).with_name('guardrun.py')
spec = importlib.util.spec_from_file_location('guardrun', source)
g = importlib.util.module_from_spec(spec)
spec.loader.exec_module(g)

# 2026-09-26、実装変更前に固定。少量の縮小も理由から消さない。
cases = [
    ('不要なimportを除く', 'report.py', 3, 2, '緑', True),
    ('小さい設定の1行削減', 'config.txt', 2, 1, '緑', True),
    ('9行削減', 'data.txt', 20, 11, '緑', True),
    ('10行削減', 'data.txt', 20, 10, '赤', True),
    ('30パーセント境界', 'data.txt', 100, 70, '赤', True),
    ('30パーセント未満', 'data.txt', 100, 71, '緑', False),
    ('既知の大幅縮小', 'data.txt', 442, 111, '赤', True),
    ('1行を空にする', 'config.txt', 1, 0, '赤', True),
    ('3行を空にする', 'config.txt', 3, 0, '赤', True),
    ('ファイル削除', 'config.txt', 1, None, '赤', True),
    ('hookの小さい変更', '.git/hooks/pre-commit', 3, 2, '赤', True),
    ('変更なし', 'data.txt', 3, 3, '青', True),
]
results = []
with tempfile.TemporaryDirectory(prefix='guardrun-shrink-') as root:
    for name, path, before, after, expected, reason_required in cases:
        case_root = Path(root) / str(len(results))
        p = case_root / path
        p.parent.mkdir(parents=True)
        p.write_text(''.join(f'value_{i}\n' for i in range(before)))
        first = g.snapshot(str(case_root))
        if after is None:
            p.unlink()
        else:
            p.write_text(''.join(f'value_{i}\n' for i in range(after)))
        delta = g.diff(first, g.snapshot(str(case_root)))
        mark, reasons = g.verdict(delta)
        ok = mark == expected and (not reason_required or bool(reasons))
        results.append(dict(case=name, expected=expected, actual=mark,
                            reasons=reasons, passed=ok))
print(json.dumps(dict(source=str(source), cases=results,
                      passed=sum(r['passed'] for r in results), total=len(results)),
                 ensure_ascii=False, indent=2))
sys.exit(0 if all(r['passed'] for r in results) else 1)
