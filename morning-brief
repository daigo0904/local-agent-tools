#!/usr/bin/env python3
"""
morning-brief — 登録テーマを順に調べて Obsidian に保存し、要点だけをまとめて出力する。

テーマは ~/.openclaw/briefing-topics.txt に1行1件で書く。
出力はそのまま LINE に流す前提なので、短くまとめる。

    morning-brief            # 全テーマを調べる
    morning-brief --dry-run  # 何を調べる予定かだけ表示

**「調べたが何も無かった」と「調べられなかった」は必ず区別する。**
2026-08-31 に17回ぶんの記録を調べたら、届かなかった7日のうち4日は
8時ちょうどに名前解決ができておらず（`getaddrinfo ENOTFOUND api.line.me`）、
検索も天気も同時に失敗していた。それを「今朝は目立った新しい話題がありませんでした」
と報告していたので、**壊れていることが誰にも見えなかった**。
残り3日は45分の上限に当たった時間切れ。
"""

import os
import re
import subprocess
import sys
from datetime import datetime

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from netlib import wait_online  # noqa: E402  外に出る前に、出られるか確かめる
from modellib import resident_model  # noqa: E402  重い調べものは、載っているモデルに任せる

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from guardlib import Guard  # noqa: E402

# 朝の便りは1日1通。**二重に走ると2通届く**（LINE は月200通しかない）。
# 落ちたときに跡が残らないのも困る——届かなかった朝、理由が分からなかった。
G = Guard("morning-brief")


TOPICS_FILE = os.path.expanduser("~/.openclaw/briefing-topics.txt")
RESEARCH = os.path.expanduser("~/bin/research-save")
INBOX = os.path.expanduser("~/知識メモ/Inbox")
PER_TOPIC_TIMEOUT = 420  # 1テーマあたりの上限（秒）


def load_topics():
    """(表示名, research-save に渡す引数) の列を返す。"""
    try:
        with open(TOPICS_FILE, encoding="utf-8") as f:
            lines = [l.strip() for l in f]
    except OSError:
        return []

    topics = []
    for l in lines:
        if not l or l.startswith("#"):
            continue
        if l.lower().startswith("news:"):
            q = l.split(":", 1)[1].strip()
            if q:
                topics.append((q, ["--news", q]))
        else:
            topics.append((l, [l]))
    return topics


def quota_ok(need=15):
    """残り送信数が極端に少ないときだけ見送る。
    ブリーフィングは声かけより重要なので、閾値は低くしてぎりぎりまで送る。"""
    quota = os.path.expanduser("~/bin/line-quota")
    if not os.path.isfile(quota):
        return True
    try:
        return subprocess.run([quota, "--check", str(need)],
                              capture_output=True, timeout=30).returncode == 0
    except Exception:
        return True


def main():
    topics = load_topics()
    if not topics:
        print(f"調べるテーマがありません。{TOPICS_FILE} に書いてください。", file=sys.stderr)
        return 1

    # **何よりも先に、外に出られるかを確かめる。**
    # 8時ちょうどはまだネットが立ち上がっていないことがある（実測で17回中4回）。
    # 数分待てば通るので、待つ。8/29 は staggerMs で 08:03 にずれ、それだけで成功していた。
    if "--dry-run" not in sys.argv:
        waited = wait_online(log=lambda m: print(m, file=sys.stderr))
        if waited is None:
            # **黙って0で終わらないこと。** 0で終わると「何も無かった」と同じ顔になり、
            # 壊れていることが記録にも残らない。
            print("ネットにつながらないので、朝の便りを出せませんでした。", file=sys.stderr)
            return 1
        if waited:
            print(f"（ネットが使えるまで {int(waited)} 秒待ちました）", file=sys.stderr)

    if "--dry-run" not in sys.argv and not quota_ok(15):
        # 調べても送れないので、検索とLLMを走らせるだけ無駄になる
        return 0

    if "--dry-run" in sys.argv:
        print("次のテーマを調べます:")
        for name, argv in topics:
            mode = "ニュース" if "--news" in argv else "通常"
            print(f" - [{mode}] {name}")
        return 0

    results = []
    skipped = []   # 調べたが、新しいものが無かった
    failed = []    # そもそも調べられなかった（理由つき）

    # **調べものは、いま載っているモデルにやらせる。**
    # 別のモデルを呼ぶと 17GB の積み直しから始まり、そのぶん丸ごと待たされる。
    # 実測 2026-08-31: 1件あたり qwen3:14b（載っていない・密14B）で 420秒たっても
    # 終わらず、gemma4:26b（載っている・MoE）なら 44秒。3件で 20分 対 2分の差になる。
    # 明示的に RESEARCH_MODEL が指定されていれば、そちらを尊重する。
    env = dict(os.environ)
    env.setdefault("RESEARCH_MODEL", resident_model())

    for topic, argv in topics:
        try:
            p = subprocess.run(
                [RESEARCH] + argv,
                capture_output=True, text=True, timeout=PER_TOPIC_TIMEOUT, env=env,
            )
            out = (p.stdout or "").strip()
        except subprocess.TimeoutExpired:
            skipped.append(f"{topic}（時間切れ）")
            failed.append(f"{topic}（{PER_TOPIC_TIMEOUT}秒で時間切れ）")
            continue
        except Exception as e:
            skipped.append(f"{topic}（{e}）")
            failed.append(f"{topic}（{e}）")
            continue

        if not out:
            # **理由を捨てないこと。** research-save は失敗の理由を stderr に書く
            # （鍵が無い／検索が失敗した／要約に失敗した）。ここで拾わないと、
            # 「応答なし」という中身のない一言だけが残る。
            why = (p.stderr or "").strip().splitlines()
            why = why[-1][:80] if why else f"理由不明（終了コード {p.returncode}）"
            skipped.append(f"{topic}（応答なし）")
            failed.append(f"{topic}（{why}）")
            continue
        if out.startswith("保存しませんでした"):
            skipped.append(topic)
            continue

        # 「保存しました: パス」の次の行以降が要点
        lines = out.splitlines()
        path = lines[0].replace("保存しました:", "").strip() if lines else ""
        bullets = [l for l in lines[1:] if l.strip().startswith("-")][:3]
        results.append((topic, path, bullets))

    today = datetime.now().strftime("%-m月%-d日")
    print(f"おはようございます。{today}の朝の便りです。")
    print()

    # 天気と予定は、取れなければ黙って飛ばす（ブリーフィング全体を壊さない）
    for helper, timeout in (("~/bin/weather-line", 60), ("~/bin/today-schedule", 240)):
        path = os.path.expanduser(helper)
        if not os.path.isfile(path):
            continue
        try:
            r = subprocess.run([path], capture_output=True, text=True, timeout=timeout)
            block = (r.stdout or "").strip()
            if block:
                print(block)
                print()
        except Exception:
            pass
    for topic, path, bullets in results:
        print(f"■ {topic}")
        for b in bullets:
            print(b)
        print(f"  → {path}")
        print()

    # **ここが今回の肝。** 3つの終わり方を、はっきり書き分ける。
    if results:
        if skipped:
            print("（新しい情報が無かったもの: " + "、".join(skipped) + "）")
        if failed:
            print("（調べられなかったもの: " + "、".join(failed) + "）")
    elif failed and len(failed) == len(topics):
        # 全滅。これを「話題がなかった」と書いてはいけない。
        print("⚠ 調べものが " + str(len(failed)) + " 件とも失敗しました。")
        for f in failed:
            print(f"  - {f}")
        print("（天気は上のとおりです。ニュースは次回に持ち越します）")
    elif failed:
        print("今朝は新しい話題がありませんでした。")
        print("（調べられなかったもの: " + "、".join(failed) + "）")
    else:
        print("今朝は目立った新しい話題がありませんでした。")

    return 0


if __name__ == "__main__":
    sys.exit(G.run(main))
